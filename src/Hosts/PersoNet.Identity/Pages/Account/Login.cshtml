@page "/account/login"
@model PersoNet.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Logowanie";
}

<h2>Zaloguj się</h2>

<form method="post">
    @if (Model.ErrorMessage is not null)
    {
        <p class="error" role="alert">@Model.ErrorMessage</p>
    }

    <input type="hidden" asp-for="ReturnUrl" />

    <label asp-for="Input.Email">E-mail</label>
    <input asp-for="Input.Email" type="email" autocomplete="username" autofocus />
    <span asp-validation-for="Input.Email" class="field-error"></span>

    <label asp-for="Input.Password">Hasło</label>
    <input asp-for="Input.Password" type="password" autocomplete="current-password" />
    <span asp-validation-for="Input.Password" class="field-error"></span>

    <label class="check">
        <input asp-for="Input.RememberMe" type="checkbox" />
        Zapamiętaj mnie
    </label>

    <button type="submit">Zaloguj</button>
</form>

<Application x:Class="PersoNet.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PersoNet.Desktop"
             ThemeMode="System">
    <!--
        Visual rules (from the ui-ux-pro-max review, adapted to a dense desktop admin tool):
        - colors only from Fluent theme resources (DynamicResource), so light, dark and high contrast all work;
        - every field has a visible label (Label with Target, Padding 0, Margin 0,16,0,4) with an access key, helper text where the format is not obvious,
          and its error directly under it; a form-level message only for errors not tied to a field;
        - one accent (primary) button per form; long operations show a progress bar and lock the form;
        - spacing on a 4 px grid: 4 / 8 / 12 / 16 / 24;
        - nothing has a fixed width that the window could squeeze: columns are proportional with minimums, button rows wrap,
          and long text trims or wraps (checked by the screenshots CI renders at 911 x 512, a 1366 x 768 laptop at 150 %);
        - icons come from the system icon font (SymbolThemeFontFamily) and always sit next to text or carry a tooltip and an
          automation name.
    -->
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:CollapsedWhenTrueConverter x:Key="CollapsedWhenTrue" />
        <local:CollapsedWhenEmptyConverter x:Key="CollapsedWhenEmpty" />


        <!-- Shared text styles. -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Heading of a group of fields inside a form ("Kontakt", "Zatrudnienie"). -->
        <Style x:Key="FormSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,24,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </Style>

        <!-- Glyph from the system icon font (Segoe Fluent Icons, or Segoe MDL2 Assets on Windows 10). -->
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Round avatar with initials; the size is set where it is used. -->
        <Style x:Key="Avatar" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <!-- Small pill with a status in words ("Zatrudniony", "obowiązuje"); colour only reinforces the text. -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextElement.FontSize" Value="12" />
            <!-- Own text colour, so the badge stays readable on a selected (accent) row. -->
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="SuccessBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </Style>

        <!-- Leave request state in words; the colour only reinforces it. -->
        <Style x:Key="StateBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Request.State}" Value="Pending">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Request.State}" Value="Approved">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Request.State}" Value="Rejected">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Small grey hint under a field, e.g. the expected format. -->
        <Style x:Key="HelperText" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- Red message; hidden while the bound text is empty, announced by screen readers when it appears. -->
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Error directly under its field. -->
        <Style x:Key="FieldError" TargetType="TextBlock" BasedOn="{StaticResource ErrorText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- Error for the whole form (connection lost, conflict not tied to one field). -->
        <Style x:Key="FormError" TargetType="TextBlock" BasedOn="{StaticResource ErrorText}">
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>

        <!-- Surface that groups one area of a screen (a list, an editor). -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Bar under a form that keeps its buttons visible while the fields above scroll. -->
        <Style x:Key="ActionBar" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="16,12" />
        </Style>

        <!-- Fields of a dialog window: a raised layer above the buttons, as in Windows 11 dialogs. -->
        <Style x:Key="DialogBody" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource LayerFillColorAltBrush}" />
        </Style>

        <!-- Buttons at the bottom of a dialog window: the main action and "Anuluj" on the right, anything else on the left. -->
        <Style x:Key="DialogFooter" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="24,16" />
        </Style>

        <!-- Row of commands above a list ("Dodaj", "Otwórz", filters); wraps when the window is narrow. -->
        <Style x:Key="Toolbar" TargetType="WrapPanel">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Centered message where a list or a card has nothing to show: what happened and what to do next. -->
        <Style x:Key="EmptyState" TargetType="StackPanel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="MaxWidth" Value="320" />
            <Setter Property="Margin" Value="16" />
        </Style>

        <!--
            Holder of the thin progress bar shown while the screen's view model (IsBusy) loads or saves. Hidden, not
            collapsed, so the content below does not jump when it appears.
            Fluent-themed controls (Label, ProgressBar, Button) get no app-level styles here: an explicit style would drop
            their Fluent look, so their spacing is set where they are used.
        -->
        <Style x:Key="BusyArea" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>

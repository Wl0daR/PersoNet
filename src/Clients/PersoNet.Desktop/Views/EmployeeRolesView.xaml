<UserControl x:Class="PersoNet.Desktop.Views.EmployeeRolesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:emp="clr-namespace:PersoNet.Desktop.Presentation.Employees;assembly=PersoNet.Desktop.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=emp:EmployeeRolesViewModel}">
    <StackPanel Margin="8,4,8,0" IsEnabled="{Binding IsIdle}">
        <TextBlock Text="Role w PersoNet" Style="{StaticResource FormSection}" />
        <TextBlock Text="Pracownik ma uprawnienia zaznaczonych ról, gdy loguje się swoim służbowym e-mailem." Style="{StaticResource HelperText}" TextWrapping="Wrap" />

        <Border Style="{StaticResource BusyArea}">
            <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" AutomationProperties.Name="Trwa wczytywanie ról" />
        </Border>

        <!-- A check box per company role, with what it is for underneath. -->
        <ItemsControl ItemsSource="{Binding Options}" Focusable="False" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type emp:RoleOption}">
                    <CheckBox IsChecked="{Binding IsChecked}" Margin="0,2" MinHeight="32" AutomationProperties.Name="{Binding Name}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                       Visibility="{Binding Description, Converter={StaticResource CollapsedWhenEmpty}}" />
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Firma nie ma jeszcze ról. Dodasz je na ekranie Role (Ctrl+8)." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="{Binding HasNoRoles, Converter={StaticResource BoolToVisibility}}" />

        <WrapPanel Margin="0,12,0,0">
            <Button Command="{Binding SaveCommand}" Padding="12,6" Margin="0,0,12,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Zapisz role" />
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding SavedMessage}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding SavedMessage, Converter={StaticResource CollapsedWhenEmpty}}" />
        </WrapPanel>

        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" />
    </StackPanel>
</UserControl>

<UserControl x:Class="PersoNet.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:home="clr-namespace:PersoNet.Desktop.Presentation.Home;assembly=PersoNet.Desktop.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=home:HomeViewModel}">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding LoadCommand}" />
    </UserControl.InputBindings>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="{Binding Greeting}" Style="{StaticResource PageTitle}" FontSize="28" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Today}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />

            <Border Style="{StaticResource BusyArea}" Margin="0,16,0,0">
                <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" AutomationProperties.Name="Trwa wczytywanie" />
            </Border>
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" Margin="0,0,0,8" />

            <!-- The company at a glance; each tile opens its screen. Tiles wrap on narrow windows. -->
            <TextBlock Text="Firma w liczbach" Style="{StaticResource SectionTitle}" Margin="0,8,0,8" />
            <WrapPanel>
                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding DataContext.EmployeesItem, RelativeSource={RelativeSource AncestorType=Window}}"
                        Width="200" Margin="0,0,12,12" Padding="16" HorizontalContentAlignment="Stretch" ToolTip="Otwórz listę pracowników (Ctrl+2)">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Zatrudnieni" Style="{StaticResource SecondaryText}" />
                        </DockPanel>
                        <TextBlock Text="{Binding EmployedCount}" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding DataContext.DepartmentsItem, RelativeSource={RelativeSource AncestorType=Window}}"
                        Width="200" Margin="0,0,12,12" Padding="16" HorizontalContentAlignment="Stretch" ToolTip="Otwórz strukturę działów (Ctrl+3)">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Działy" Style="{StaticResource SecondaryText}" />
                        </DockPanel>
                        <TextBlock Text="{Binding DepartmentCount}" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding DataContext.PositionsItem, RelativeSource={RelativeSource AncestorType=Window}}"
                        Width="200" Margin="0,0,12,12" Padding="16" HorizontalContentAlignment="Stretch" ToolTip="Otwórz słownik stanowisk (Ctrl+4)">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="&#xE821;" Style="{StaticResource Icon}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Stanowiska" Style="{StaticResource SecondaryText}" />
                        </DockPanel>
                        <TextBlock Text="{Binding PositionCount}" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding DataContext.EmployeesItem, RelativeSource={RelativeSource AncestorType=Window}}"
                        Width="200" Margin="0,0,12,12" Padding="16" HorizontalContentAlignment="Stretch" ToolTip="Byłych pracowników pokażesz na liście pracowników">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Byli pracownicy" Style="{StaticResource SecondaryText}" />
                        </DockPanel>
                        <TextBlock Text="{Binding FormerCount}" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                </Button>
            </WrapPanel>

            <!-- Most common tasks, one click away. -->
            <TextBlock Text="Szybkie akcje" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
            <WrapPanel>
                <Button Command="{Binding DataContext.AddEmployeeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,8" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8FA;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                        <TextBlock Text="Dodaj pracownika" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding DataContext.AddDepartmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,8" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                        <TextBlock Text="Dodaj dział" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding DataContext.AddPositionCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,8" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                        <TextBlock Text="Dodaj stanowisko" />
                    </StackPanel>
                </Button>
            </WrapPanel>

            <!-- Keyboard shortcuts, so they can be discovered without a manual. -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" HorizontalAlignment="Left" MaxWidth="640">
                <StackPanel>
                    <TextBlock Text="Skróty klawiszowe" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Ctrl+1…4" FontWeight="SemiBold" Margin="0,2,24,2" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Start, Pracownicy, Działy, Stanowiska" Style="{StaticResource SecondaryText}" Margin="0,2" />
                        <TextBlock Grid.Row="1" Text="Ctrl+N" FontWeight="SemiBold" Margin="0,2,24,2" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Nowy wpis na otwartym ekranie" Style="{StaticResource SecondaryText}" Margin="0,2" />
                        <TextBlock Grid.Row="2" Text="Ctrl+F" FontWeight="SemiBold" Margin="0,2,24,2" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Szukaj pracownika" Style="{StaticResource SecondaryText}" Margin="0,2" />
                        <TextBlock Grid.Row="3" Text="Enter" FontWeight="SemiBold" Margin="0,2,24,2" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Zapisz formularz" Style="{StaticResource SecondaryText}" Margin="0,2" />
                        <TextBlock Grid.Row="4" Text="F5" FontWeight="SemiBold" Margin="0,2,24,2" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Odśwież dane" Style="{StaticResource SecondaryText}" Margin="0,2" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

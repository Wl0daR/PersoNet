<UserControl x:Class="PersoNet.Desktop.Views.EmployeeHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:emp="clr-namespace:PersoNet.Desktop.Presentation.Employees;assembly=PersoNet.Desktop.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=emp:EmployeeHistoryViewModel}">
    <DockPanel Margin="8,12,8,8">
        <!-- Narrow the history to one kind of record, and read it again. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Padding="12,6" Margin="8,0,0,0" VerticalAlignment="Bottom"
                    IsEnabled="{Binding IsIdle}" ToolTip="Wczytaj historię ponownie">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Odśwież" />
                </StackPanel>
            </Button>
            <WrapPanel VerticalAlignment="Bottom">
                <StackPanel Margin="0,0,16,0">
                    <Label Content="Pok_aż" Target="{Binding ElementName=SubjectBox}" Padding="0" Margin="0,0,0,4" />
                    <ComboBox x:Name="SubjectBox" ItemsSource="{Binding Subjects}" SelectedItem="{Binding Subject}" MinWidth="200" />
                </StackPanel>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryText}" VerticalAlignment="Bottom" Margin="0,0,0,8" />
            </WrapPanel>
        </DockPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource BusyArea}">
            <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" AutomationProperties.Name="Trwa wczytywanie historii" />
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" />

        <Grid>
            <!-- Newest first: when and who, what happened, then each field before and after. -->
            <ListView ItemsSource="{Binding Items}" AutomationProperties.Name="Historia zmian pracownika" BorderThickness="0" Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Description}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type emp:HistoryItem}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="8,0,0,0" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Subject}" />
                                </Border>
                                <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Text="{Binding WhenAndWho}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <ItemsControl ItemsSource="{Binding Changes}" Margin="0,6,0,0" Focusable="False"
                                          Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type emp:HistoryChange}">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Brak zmian" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource SecondaryText}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>

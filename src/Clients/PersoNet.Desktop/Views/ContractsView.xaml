<UserControl x:Class="PersoNet.Desktop.Views.ContractsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:emp="clr-namespace:PersoNet.Desktop.Presentation.Employees;assembly=PersoNet.Desktop.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=emp:ContractsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,16,8,16">
            <Border Style="{StaticResource BusyArea}">
                <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" AutomationProperties.Name="Trwa wczytywanie umów" />
            </Border>

            <!-- Contracts, newest first; the current one is marked in words. -->
            <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" MaxHeight="220"
                     AutomationProperties.Name="Umowy pracownika" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type emp:ContractRow}">
                        <StackPanel Margin="0,4">
                            <TextBlock Text="{Binding TypeName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource SecondaryText}">
                                <Run Text="{Binding Period, Mode=OneWay}" /><Run Text="{Binding WorkingTimeText, Mode=OneWay, StringFormat=' · {0}', TargetNullValue=''}" />
                            </TextBlock>
                            <TextBlock Text="obowiązuje" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                       Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Ten pracownik nie ma jeszcze umów. Uzupełnij formularz poniżej i kliknij Zapisz umowę."
                       Style="{StaticResource SecondaryText}" Margin="0,4,0,0"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <!-- Editor of the selected or new contract. -->
            <Border Margin="0,16,0,0" Padding="0,16,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel IsEnabled="{Binding IsIdle}">
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitle}" />

                    <Label Content="_Rodzaj umowy *" Target="{Binding ElementName=KindBox}" Padding="0" Margin="0,12,0,4" />
                    <ComboBox x:Name="KindBox" ItemsSource="{x:Static emp:ContractsViewModel.Kinds}" SelectedItem="{Binding EditKind}"
                              DisplayMemberPath="Name" HorizontalAlignment="Stretch" />

                    <Label Content="_Początek *" Target="{Binding ElementName=StartBox}" Padding="0" Margin="0,16,0,4" />
                    <DatePicker x:Name="StartBox" SelectedDate="{Binding EditStartDate}"
                                AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                    <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=StartBox}" Style="{StaticResource FieldError}" />

                    <!-- An indefinite contract has no end date, so the field is not offered. -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsIndefinite}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Label Content="{Binding EndDateLabel}" Target="{Binding ElementName=EndBox}" Padding="0" Margin="0,16,0,4" />
                        <DatePicker x:Name="EndBox" SelectedDate="{Binding EditEndDate}"
                                    AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                        <TextBlock Text="{Binding EndDateHint}" Style="{StaticResource HelperText}" />
                        <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=EndBox}" Style="{StaticResource FieldError}" />
                    </StackPanel>

                    <!-- Working time applies only to employment contracts. -->
                    <StackPanel Visibility="{Binding IsEmploymentContract, Converter={StaticResource BoolToVisibility}}">
                        <Label Content="_Wymiar etatu *" Target="{Binding ElementName=WorkingTimeBox}" Padding="0" Margin="0,16,0,4" />
                        <TextBox x:Name="WorkingTimeBox" Text="{Binding EditWorkingTime, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Width="120" HorizontalAlignment="Left"
                                 AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                        <TextBlock Text="Np. 1 (pełny etat), 1/2 albo 0,75." Style="{StaticResource HelperText}" />
                        <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=WorkingTimeBox}" Style="{StaticResource FieldError}" />
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" />

                    <DockPanel Margin="0,24,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Zapisz umowę" Command="{Binding SaveCommand}"
                                Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0" />
                        <Button DockPanel.Dock="Left" Content="Nowa umowa" Command="{Binding NewCommand}" />
                        <!-- Removal is for entries made by mistake; it needs a second click. -->
                        <Button DockPanel.Dock="Right" Content="{Binding DeleteText}" Command="{Binding DeleteCommand}" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

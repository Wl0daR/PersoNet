<UserControl x:Class="PersoNet.Desktop.Views.ContractsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:emp="clr-namespace:PersoNet.Desktop.Presentation.Employees;assembly=PersoNet.Desktop.Presentation"
             xmlns:local="clr-namespace:PersoNet.Desktop.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=emp:ContractsViewModel}">
    <DockPanel Margin="8,12,8,8">
        <!-- Commands for the contracts: add, change and remove the picked one (removal needs a second click). -->
        <WrapPanel DockPanel.Dock="Top" Style="{StaticResource Toolbar}" IsEnabled="{Binding IsIdle}">
            <Button Command="{Binding NewCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="12,6" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Dodaj umowę" />
                </StackPanel>
            </Button>
            <Button Command="{Binding EditCommand}" Padding="12,6" Margin="0,0,8,8" ToolTip="Zmień zaznaczoną umowę (Enter)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Zmień" />
                </StackPanel>
            </Button>
            <Button Command="{Binding DeleteCommand}" Padding="12,6" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding DeleteText}" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource BusyArea}">
            <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" AutomationProperties.Name="Trwa wczytywanie umów" />
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" />

        <Grid>
            <!-- Contracts, newest first; the current one is marked in words. Double click or Enter changes one. -->
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" local:OpenOnActivate.Command="{Binding EditCommand}"
                      AutomationProperties.Name="Umowy pracownika" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="None" MinRowHeight="44" BorderThickness="0" Background="Transparent"
                      CanUserSortColumns="False" CanUserReorderColumns="False" HorizontalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Rodzaj umowy" Width="2*" MinWidth="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type emp:ContractRow}">
                                <TextBlock Text="{Binding TypeName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding TypeName}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Okres" Width="2*" MinWidth="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type emp:ContractRow}">
                                <TextBlock Text="{Binding Period}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Period}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Etat" Width="*" MinWidth="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type emp:ContractRow}">
                                <TextBlock Text="{Binding WorkingTimeText, TargetNullValue='—'}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="Auto" MinWidth="96">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type emp:ContractRow}">
                                <Border Style="{StaticResource SuccessBadge}" Margin="0,0,8,0" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="obowiązuje" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Brak umów" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="Kliknij „Dodaj umowę”, aby wpisać pierwszą umowę tej osoby." Style="{StaticResource SecondaryText}" TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>

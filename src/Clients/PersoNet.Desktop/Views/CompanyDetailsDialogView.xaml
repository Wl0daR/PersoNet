<UserControl x:Class="PersoNet.Desktop.Views.CompanyDetailsDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:company="clr-namespace:PersoNet.Desktop.Presentation.Company;assembly=PersoNet.Desktop.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=company:CompanyDetailsDialogViewModel}"
             Width="560" MaxHeight="760">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" IsEnabled="{Binding IsIdle}">
                <Button Content="Zapisz" Command="{Binding SaveCommand}" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" MinWidth="110" Margin="0,0,8,0" />
                <Button Content="Anuluj" IsCancel="True" MinWidth="110" ToolTip="Zamknij bez zapisywania (Esc)" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource DialogBody}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,20" IsEnabled="{Binding IsIdle}">
                    <TextBlock Text="Pola oznaczone * są wymagane." Style="{StaticResource HelperText}" Margin="0" />

                    <Label Content="_Nazwa firmy *" Target="{Binding ElementName=NameBox}" Padding="0" Margin="0,16,0,4" />
                    <TextBox x:Name="NameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="{x:Static company:CompanyDetailsDialogViewModel.NameMaxLength}"
                             AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                    <TextBlock Text="Krótka nazwa widoczna w aplikacjach, np. Acme." Style="{StaticResource HelperText}" />
                    <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=NameBox}" Style="{StaticResource FieldError}" />

                    <Label Content="_Pełna nazwa" Target="{Binding ElementName=LegalNameBox}" Padding="0" Margin="0,16,0,4" />
                    <TextBox x:Name="LegalNameBox" Text="{Binding EditLegalName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="{x:Static company:CompanyDetailsDialogViewModel.LegalNameMaxLength}"
                             AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                    <TextBlock Text="Jak w rejestrze, np. Acme Polska sp. z o.o." Style="{StaticResource HelperText}" />
                    <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=LegalNameBox}" Style="{StaticResource FieldError}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Content="N_IP" Target="{Binding ElementName=TaxIdBox}" Padding="0" Margin="0,16,0,4" />
                            <TextBox x:Name="TaxIdBox" Text="{Binding EditTaxId, UpdateSourceTrigger=PropertyChanged}" MaxLength="16"
                                     AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                            <TextBlock Text="10 cyfr, np. 526-104-38-38." Style="{StaticResource HelperText}" />
                            <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=TaxIdBox}" Style="{StaticResource FieldError}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="_REGON" Target="{Binding ElementName=RegonBox}" Padding="0" Margin="0,16,0,4" />
                            <TextBox x:Name="RegonBox" Text="{Binding EditRegon, UpdateSourceTrigger=PropertyChanged}" MaxLength="17"
                                     AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                            <TextBlock Text="9 lub 14 cyfr." Style="{StaticResource HelperText}" />
                            <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=RegonBox}" Style="{StaticResource FieldError}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Adres" Style="{StaticResource FormSection}" />

                    <Label Content="_Ulica i numer" Target="{Binding ElementName=StreetBox}" Padding="0" Margin="0,8,0,4" />
                    <TextBox x:Name="StreetBox" Text="{Binding EditStreet, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="{x:Static company:CompanyDetailsDialogViewModel.StreetMaxLength}"
                             AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                    <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=StreetBox}" Style="{StaticResource FieldError}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Content="_Kod pocztowy" Target="{Binding ElementName=PostalCodeBox}" Padding="0" Margin="0,16,0,4" />
                            <TextBox x:Name="PostalCodeBox" Text="{Binding EditPostalCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="6"
                                     AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                            <TextBlock Text="Np. 00-850." Style="{StaticResource HelperText}" />
                            <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=PostalCodeBox}" Style="{StaticResource FieldError}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="_Miejscowość" Target="{Binding ElementName=CityBox}" Padding="0" Margin="0,16,0,4" />
                            <TextBox x:Name="CityBox" Text="{Binding EditCity, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="{x:Static company:CompanyDetailsDialogViewModel.CityMaxLength}"
                                     AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                            <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=CityBox}" Style="{StaticResource FieldError}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Kontakt" Style="{StaticResource FormSection}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Content="_E-mail" Target="{Binding ElementName=EmailBox}" Padding="0" Margin="0,8,0,4" />
                            <TextBox x:Name="EmailBox" Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="{x:Static company:CompanyDetailsDialogViewModel.EmailMaxLength}"
                                     AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                            <TextBlock Text="Np. kadry@firma.pl." Style="{StaticResource HelperText}" />
                            <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=EmailBox}" Style="{StaticResource FieldError}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="_Telefon" Target="{Binding ElementName=PhoneBox}" Padding="0" Margin="0,8,0,4" />
                            <TextBox x:Name="PhoneBox" Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="{x:Static company:CompanyDetailsDialogViewModel.PhoneMaxLength}"
                                     AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                            <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=PhoneBox}" Style="{StaticResource FieldError}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>

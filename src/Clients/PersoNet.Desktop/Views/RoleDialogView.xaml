<UserControl x:Class="PersoNet.Desktop.Views.RoleDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:acc="clr-namespace:PersoNet.Desktop.Presentation.Access;assembly=PersoNet.Desktop.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=acc:RoleDialogViewModel}"
             Width="560" MaxHeight="720">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" IsEnabled="{Binding IsIdle}">
                <Button Content="Zapisz" Command="{Binding SaveCommand}" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" MinWidth="110" Margin="0,0,8,0" />
                <Button Content="Anuluj" IsCancel="True" MinWidth="110" ToolTip="Zamknij bez zapisywania (Esc)" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource DialogBody}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,20" IsEnabled="{Binding IsIdle}">
                    <Label Content="_Nazwa roli *" Target="{Binding ElementName=NameBox}" Padding="0" Margin="0,0,0,4" />
                    <TextBox x:Name="NameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="{x:Static acc:RoleDialogViewModel.NameMaxLength}"
                             AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                    <TextBlock Text="Np. Kierownik działu, Kadrowa, Księgowość." Style="{StaticResource HelperText}" />
                    <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=NameBox}" Style="{StaticResource FieldError}" />

                    <Label Content="_Opis" Target="{Binding ElementName=DescriptionBox}" Padding="0" Margin="0,12,0,4" />
                    <TextBox x:Name="DescriptionBox" Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="False"
                             MaxLength="{x:Static acc:RoleDialogViewModel.DescriptionMaxLength}"
                             AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                    <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=DescriptionBox}" Style="{StaticResource FieldError}" />

                    <TextBlock Text="Uprawnienia" Style="{StaticResource FormSection}" Margin="0,16,0,0" />
                    <TextBlock Text="Zaznacz, co mogą osoby z tą rolą. Działa od razu po zapisaniu." Style="{StaticResource HelperText}" TextWrapping="Wrap" />

                    <!-- One heading per area, a check box per permission with what it lets do underneath. -->
                    <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type acc:PermissionGroup}">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type acc:PermissionOption}">
                                                <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" Margin="0,2" MinHeight="32"
                                                          AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Description}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" />
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>

<UserControl x:Class="PersoNet.Desktop.Views.WorkDayDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:work="clr-namespace:PersoNet.Desktop.Presentation.WorkTime;assembly=PersoNet.Desktop.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=work:WorkDayDialogViewModel}"
             Width="500">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel IsEnabled="{Binding IsIdle}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Zapisz" Command="{Binding SaveCommand}" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" MinWidth="110" Margin="0,0,8,0" />
                    <Button Content="Anuluj" IsCancel="True" MinWidth="110" ToolTip="Zamknij bez zapisywania (Esc)" />
                </StackPanel>
                <!-- Removing a typed day; a day the reader recorded gets its hours back from the clock events. -->
                <Button Content="{Binding ClearText}" Command="{Binding ClearCommand}" HorizontalAlignment="Left" MinWidth="110"
                        Visibility="{Binding CanClear, Converter={StaticResource BoolToVisibility}}" />
            </DockPanel>
        </Border>

        <Border Style="{StaticResource DialogBody}">
            <StackPanel Margin="24,20,24,20" IsEnabled="{Binding IsIdle}">
                <TextBlock Text="{Binding DayInfo}" Style="{StaticResource SecondaryText}" />

                <!-- What the reader recorded, so a correction starts from the facts. -->
                <Border Margin="0,12,0,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        Visibility="{Binding HasEvents, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Odbicia z czytnika" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding EventsText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding LeaveText}" Style="{StaticResource HelperText}" Margin="0,8,0,0"
                           Visibility="{Binding HasLeave, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <RadioButton Content="_Praca" IsChecked="{Binding IsWork}" GroupName="DayKind" Margin="0,0,24,0" MinHeight="32" />
                    <RadioButton Content="_Nieobecność" IsChecked="{Binding IsAbsence}" GroupName="DayKind" MinHeight="32" />
                </StackPanel>

                <!-- Hours worked: from, to (earlier than from means the next day) and the time out in between. -->
                <Grid Visibility="{Binding IsWork, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="_Od *" Target="{Binding ElementName=StartBox}" Padding="0" Margin="0,12,0,4" />
                        <TextBox x:Name="StartBox" Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" MaxLength="5"
                                 AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                        <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=StartBox}" Style="{StaticResource FieldError}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="_Do *" Target="{Binding ElementName=EndBox}" Padding="0" Margin="0,12,0,4" />
                        <TextBox x:Name="EndBox" Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}" MaxLength="5"
                                 AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                        <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=EndBox}" Style="{StaticResource FieldError}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <Label Content="P_rzerwa (min)" Target="{Binding ElementName=BreakBox}" Padding="0" Margin="0,12,0,4" />
                        <TextBox x:Name="BreakBox" Text="{Binding BreakText, UpdateSourceTrigger=PropertyChanged}" MaxLength="3"
                                 AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                        <TextBlock Text="Niewliczana do czasu pracy." Style="{StaticResource HelperText}" />
                        <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=BreakBox}" Style="{StaticResource FieldError}" />
                    </StackPanel>
                </Grid>

                <StackPanel Visibility="{Binding IsAbsence, Converter={StaticResource BoolToVisibility}}">
                    <Label Content="_Rodzaj nieobecności *" Target="{Binding ElementName=AbsenceBox}" Padding="0" Margin="0,12,0,4" />
                    <ComboBox x:Name="AbsenceBox" ItemsSource="{Binding Absences}" SelectedItem="{Binding Absence}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                    <TextBlock Text="Urlopy wpisuje się w zakładce Urlop; pojawiają się tu same." Style="{StaticResource HelperText}" />
                </StackPanel>

                <Label Content="_Uwagi" Target="{Binding ElementName=NoteBox}" Padding="0" Margin="0,12,0,4" />
                <TextBox x:Name="NoteBox" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                         AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=NoteBox}" Style="{StaticResource FieldError}" />

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" />
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>

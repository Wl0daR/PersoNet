<UserControl x:Class="PersoNet.Desktop.Views.ClockIdDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:work="clr-namespace:PersoNet.Desktop.Presentation.WorkTime;assembly=PersoNet.Desktop.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=work:ClockIdDialogViewModel}"
             Width="440">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" IsEnabled="{Binding IsIdle}">
                <Button Content="Zapisz" Command="{Binding SaveCommand}" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" MinWidth="110" Margin="0,0,8,0" />
                <Button Content="Anuluj" IsCancel="True" MinWidth="110" ToolTip="Zamknij bez zapisywania (Esc)" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource DialogBody}">
            <StackPanel Margin="24,20,24,20" IsEnabled="{Binding IsIdle}">
                <TextBlock Text="Po tym identyfikatorze PersoNet rozpoznaje odbicia pracownika z systemu RCP. Wpisz go dokładnie tak, jak w systemie RCP, np. numer karty w Roger PR Master."
                           Style="{StaticResource SecondaryText}" />
                <Label Content="_Identyfikator RCP" Target="{Binding ElementName=ClockIdBox}" Padding="0" Margin="0,16,0,4" />
                <TextBox x:Name="ClockIdBox" Text="{Binding ClockId, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"
                         AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                <TextBlock Text="Zostaw puste, jeśli pracownik nie odbija się w systemie RCP." Style="{StaticResource HelperText}" />
                <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=ClockIdBox}" Style="{StaticResource FieldError}" />
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" />
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>

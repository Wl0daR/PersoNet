<UserControl x:Class="PersoNet.Desktop.Views.CompanyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:company="clr-namespace:PersoNet.Desktop.Presentation.Company;assembly=PersoNet.Desktop.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=company:CompanyViewModel}">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding LoadCommand}" />
    </UserControl.InputBindings>

    <DockPanel>
        <!-- Page header: what this screen is. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Command="{Binding LoadCommand}" Padding="8" Margin="8,0,0,0" VerticalAlignment="Top"
                    ToolTip="Odśwież (F5)" AutomationProperties.Name="Odśwież">
                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" />
            </Button>
            <StackPanel>
                <TextBlock Text="Ustawienia firmy" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Dane firmy, urlopy, o które pracownicy proszą sami w portalu, i źródło czasu pracy." Style="{StaticResource SecondaryText}" />
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" Margin="0,8,0,0" />

        <Border DockPanel.Dock="Top" Style="{StaticResource BusyArea}" Margin="0,0,0,8">
            <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" AutomationProperties.Name="Trwa wczytywanie" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left" Grid.IsSharedSizeScope="True">
                <!-- Company data, read-only; "Zmień dane" opens the form in a window. -->
                <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Command="{Binding EditDetailsCommand}" Padding="12,6" VerticalAlignment="Top" Margin="16,0,0,0"
                                    ToolTip="Zmień nazwę, NIP, REGON, adres i kontakt">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Zmień dane" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="&#xE731;" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel>
                                <TextBlock Text="Dane firmy" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Nazwa firmy pojawia się w aplikacjach. NIP i REGON przydadzą się w dokumentach kadrowych."
                                           Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding Details}" Focusable="False" AutomationProperties.Name="Dane firmy">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type company:CompanyFact}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="FactLabel" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource SecondaryText}" Margin="0,0,24,0" MinWidth="110" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGiven}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                            <Setter Property="FontStyle" Value="Italic" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Kinds of leave in the portal; the rest are registered by HR in this app. -->
                <Border Style="{StaticResource Card}" Padding="20,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Command="{Binding EditLeaveCommand}" Padding="12,6" VerticalAlignment="Top" Margin="16,0,0,0"
                                    ToolTip="Wybierz, o które urlopy pracownicy proszą w portalu">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Zmień" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="&#xE787;" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel>
                                <TextBlock Text="Urlopy w portalu" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding PortalSummary}" Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding LeaveKinds}" Focusable="False" AutomationProperties.Name="Rodzaje urlopów">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type company:PortalLeaveRow}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="LeaveName" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Margin="0,0,24,0" VerticalAlignment="Center" />
                                        <!-- Said in words; the colour only reinforces it. -->
                                        <Border Grid.Column="1">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding InPortal}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Where}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Dział kadr może wpisać każdy rodzaj urlopu na ekranie Urlopy, niezależnie od tego ustawienia."
                                   Style="{StaticResource HelperText}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- Where working time comes from: typed by HR, imported, or sent by the time clock system. -->
                <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,16,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding EditWorkTimeCommand}" Padding="12,6" VerticalAlignment="Top" Margin="16,0,0,0"
                                ToolTip="Wybierz, skąd pochodzi czas pracy">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Zmień" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel>
                            <TextBlock Text="Czas pracy" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource SecondaryText}">
                                <Run Text="Źródło: " /><Run Text="{Binding WorkTimeSource, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Text="{Binding WorkTimeHint}" Style="{StaticResource HelperText}" Margin="0,4,0,0" />
                            <TextBlock Text="Każdy dzień można wpisać i poprawić ręcznie w karcie pracownika, w zakładce Czas pracy."
                                       Style="{StaticResource HelperText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

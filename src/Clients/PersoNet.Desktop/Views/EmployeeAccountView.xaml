<UserControl x:Class="PersoNet.Desktop.Views.EmployeeAccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:emp="clr-namespace:PersoNet.Desktop.Presentation.Employees;assembly=PersoNet.Desktop.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=emp:EmployeeAccountViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8,4,8,20" IsEnabled="{Binding IsIdle}">
            <WrapPanel Margin="0,12,0,0">
                <TextBlock Text="Dostęp do portalu pracownika" Style="{StaticResource FormSection}" Margin="0,0,10,0" />
                <Border VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Account.State}" Value="Active">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Account.State}" Value="Invited">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Account.State}" Value="Blocked">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StateBadge}" />
                </Border>
            </WrapPanel>

            <TextBlock Text="{Binding StateText}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock Text="{Binding HelpText}" Style="{StaticResource HelperText}" TextWrapping="Wrap"
                       Visibility="{Binding HelpText, Converter={StaticResource CollapsedWhenEmpty}}" />

            <WrapPanel Margin="0,16,0,0">
                <Button Command="{Binding CreateLinkCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="12,6" Margin="0,0,8,8"
                        Visibility="{Binding HasEmail, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71B;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding LinkButtonText}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding BlockCommand}" Padding="12,6" Margin="0,0,8,8"
                        Visibility="{Binding CanBlock, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Pracownik nie zaloguje się, a otwarte sesje zostaną zakończone.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding BlockText}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding UnblockCommand}" Padding="12,6" Margin="0,0,8,8"
                        Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE785;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Odblokuj konto" />
                    </StackPanel>
                </Button>
            </WrapPanel>

            <Border Style="{StaticResource BusyArea}">
                <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" AutomationProperties.Name="Trwa łączenie z serwerem" />
            </Border>

            <!-- The link to pass on: selectable text plus a copy button, since e-mail is not sent yet. -->
            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="16,4,16,16" Margin="0,8,0,0"
                    Visibility="{Binding HasLink, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Label Content="_Link do ustawienia hasła" Target="{Binding ElementName=LinkBox}" Padding="0" Margin="0,12,0,4" />
                    <DockPanel>
                        <Button x:Name="CopyButton" DockPanel.Dock="Right" Click="OnCopy" Padding="12,6" Margin="8,0,0,0"
                                AutomationProperties.Name="Kopiuj link">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock x:Name="CopyText" Text="Kopiuj" />
                            </StackPanel>
                        </Button>
                        <TextBox x:Name="LinkBox" Text="{Binding LinkText, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" />
                    </DockPanel>
                    <TextBlock Text="{Binding LinkHelp}" Style="{StaticResource HelperText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="PersoNet.Desktop.Views.LeaveDecisionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:leave="clr-namespace:PersoNet.Desktop.Presentation.Leave;assembly=PersoNet.Desktop.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=leave:LeaveDecisionViewModel}"
             Width="540">
    <!-- One request: its facts, the employee's balance and, while it waits, the decision. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel IsEnabled="{Binding IsIdle}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding CanDecide, Converter={StaticResource BoolToVisibility}}">
                        <Button Command="{Binding ApproveCommand}" Style="{DynamicResource AccentButtonStyle}" MinWidth="110" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Zatwierdź" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RejectCommand}" MinWidth="110" Margin="0,0,8,0" ToolTip="Wymaga podania powodu">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Odrzuć" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Content="Zamknij" IsCancel="True" MinWidth="110" ToolTip="Zamknij okno (Esc)" />
                </StackPanel>
                <!-- Cancelling sits apart from the decision and needs a second click. -->
                <Button Content="{Binding CancelText}" Command="{Binding CancelLeaveCommand}" HorizontalAlignment="Left" Margin="0,0,16,0"
                        ToolTip="Wycofaj wniosek; dni wracają do salda"
                        Visibility="{Binding CanCancelLeave, Converter={StaticResource BoolToVisibility}}" />
            </DockPanel>
        </Border>

        <Border Style="{StaticResource DialogBody}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,20">
                    <!-- Who asks, and the state in words. -->
                    <DockPanel DataContext="{Binding Row}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource Avatar}" Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top">
                            <TextBlock Text="{Binding EmployeeInitials}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <WrapPanel>
                                <TextBlock Text="{Binding Request.EmployeeName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,0" />
                                <Border Style="{StaticResource StateBadge}">
                                    <TextBlock Text="{Binding StateName}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="{Binding Request.EmployeeNumber}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <!-- The facts of the request. -->
                    <Grid DataContext="{Binding Row}" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Rodzaj" Style="{StaticResource SecondaryText}" Margin="0,4,16,4" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding KindName}" TextWrapping="Wrap" Margin="0,4" />
                        <TextBlock Grid.Row="1" Text="Termin" Style="{StaticResource SecondaryText}" Margin="0,4,16,4" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Period}" TextWrapping="Wrap" Margin="0,4" />
                        <TextBlock Grid.Row="2" Text="Wymiar" Style="{StaticResource SecondaryText}" Margin="0,4,16,4" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ExtentText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4" />
                        <TextBlock Grid.Row="3" Text="Uwagi" Style="{StaticResource SecondaryText}" Margin="0,4,16,4" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Request.Note, TargetNullValue='—'}" TextWrapping="Wrap" Margin="0,4" />
                    </Grid>

                    <!-- Balance of the employee, so the decision is made with it in view. -->
                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            Visibility="{Binding BalanceText, Converter={StaticResource CollapsedWhenEmpty}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Icon}" Margin="0,0,10,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding BalanceText}" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <!-- Decision already made. -->
                    <StackPanel Visibility="{Binding CanDecide, Converter={StaticResource CollapsedWhenTrue}}">
                        <TextBlock Text="Decyzja" Style="{StaticResource FormSection}" />
                        <TextBlock Text="{Binding Row.DecisionText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Row.Request.DecisionNote}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"
                                   Visibility="{Binding Row.Request.DecisionNote, Converter={StaticResource CollapsedWhenEmpty}}" />
                    </StackPanel>

                    <TextBlock Text="Decyzja" Style="{StaticResource FormSection}" Visibility="{Binding CanDecide, Converter={StaticResource BoolToVisibility}}" />
                    <Label Content="_Uwagi do decyzji" Target="{Binding ElementName=DecisionBox}" Padding="0" Margin="0,12,0,4" />
                    <TextBox x:Name="DecisionBox" Text="{Binding DecisionNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="64" MaxLength="{x:Static leave:LeaveDecisionViewModel.NoteMaxLength}" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                    <TextBlock Text="Przy odrzuceniu wymagane: pracownik zobaczy powód." Style="{StaticResource HelperText}" />
                    <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=DecisionBox}" Style="{StaticResource FieldError}" />

                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>

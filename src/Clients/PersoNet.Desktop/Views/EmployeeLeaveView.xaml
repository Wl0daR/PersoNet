<UserControl x:Class="PersoNet.Desktop.Views.EmployeeLeaveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:leave="clr-namespace:PersoNet.Desktop.Presentation.Leave;assembly=PersoNet.Desktop.Presentation"
             xmlns:local="clr-namespace:PersoNet.Desktop.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=leave:EmployeeLeaveViewModel}">
    <UserControl.Resources>
        <!-- A day cell: a frame that shows the picked day, with no list-style selection fill. -->
        <Style x:Key="CalendarCell" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ToolTip" Value="{Binding Description}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Leave on the day, as a fill; the words are in the tooltip and under the calendar. -->
        <Style x:Key="LeaveFill" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsApproved}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPending}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Day number: dimmed on weekends, red on public holidays, bold today, faint outside the month. -->
        <Style x:Key="DayNumber" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDayOff}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHoliday}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInMonth}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="8,12,8,0">
        <!-- Commands for the tab: a new request (from the picked day) and the year's entitlement. -->
        <WrapPanel DockPanel.Dock="Top" Style="{StaticResource Toolbar}" IsEnabled="{Binding IsIdle}">
            <Button Command="{Binding AddLeaveCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="12,6" Margin="0,0,8,8"
                    ToolTip="Nowy wniosek od dnia zaznaczonego w kalendarzu">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Dodaj urlop" />
                </StackPanel>
            </Button>
            <Button Command="{Binding EditEntitlementCommand}" Padding="12,6" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE787;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock>
                        <Run Text="Wymiar urlopu " /><Run Text="{Binding Year, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Button>
        </WrapPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource BusyArea}">
            <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" AutomationProperties.Name="Trwa wczytywanie urlopu" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Month calendar: leave and days off at a glance. A double click opens the day's request, or a new one. -->
                <StackPanel Grid.Column="0" Width="340">
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Dziś" Command="{Binding ThisMonthCommand}" Padding="10,4" ToolTip="Wróć do bieżącego miesiąca" />
                        <Button DockPanel.Dock="Left" Command="{Binding PreviousMonthCommand}" Padding="8" Background="Transparent" BorderThickness="0"
                                ToolTip="Poprzedni miesiąc" AutomationProperties.Name="Poprzedni miesiąc">
                            <TextBlock Text="&#xE76B;" Style="{StaticResource Icon}" FontSize="12" />
                        </Button>
                        <Button DockPanel.Dock="Left" Command="{Binding NextMonthCommand}" Padding="8" Background="Transparent" BorderThickness="0"
                                ToolTip="Następny miesiąc" AutomationProperties.Name="Następny miesiąc">
                            <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="12" />
                        </Button>
                        <TextBlock Text="{Binding MonthTitle}" Style="{StaticResource SectionTitle}" Margin="8,0" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>

                    <ItemsControl ItemsSource="{x:Static leave:LeaveCalendar.WeekdayNames}" Focusable="False" Margin="0,0,0,2">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource SecondaryText}" FontSize="12" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ListBox x:Name="CalendarBox" ItemsSource="{Binding Days}" SelectedItem="{Binding SelectedDay}" ItemContainerStyle="{StaticResource CalendarCell}"
                             local:OpenOnActivate.Command="{Binding OpenDayCommand}"
                             Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="{Binding MonthTitle, StringFormat='Kalendarz: {0}'}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type leave:CalendarDay}">
                                <Grid Height="40" MinWidth="36">
                                    <Border Style="{StaticResource LeaveFill}" />
                                    <TextBlock Text="{Binding Day}" Style="{StaticResource DayNumber}" />
                                    <TextBlock Text="h" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,2"
                                               Visibility="{Binding IsHourly, Converter={StaticResource BoolToVisibility}}" />
                                    <Rectangle Height="2" Width="14" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                               Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                               Visibility="{Binding IsToday, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Legend: what the colours mean, in words. -->
                    <WrapPanel Margin="0,8,0,0" TextElement.FontSize="12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                            <Border Style="{StaticResource Swatch}" Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1" />
                            <TextBlock Text="zatwierdzony" Style="{StaticResource SecondaryText}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                            <Border Style="{StaticResource Swatch}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1" />
                            <TextBlock Text="oczekuje" Style="{StaticResource SecondaryText}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                            <TextBlock Text="12" FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="święto" Style="{StaticResource SecondaryText}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                            <TextBlock Text="h" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0" />
                            <TextBlock Text="urlop w godzinach" Style="{StaticResource SecondaryText}" FontSize="12" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- The picked day in words, with what can be done on it. -->
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="16,12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedDay.LongDate, FallbackValue='Wybierz dzień w kalendarzu'}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedDay.Description}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Visibility="{Binding SelectedDay.HasLeave, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                <Run Text="{Binding SelectedDay.Leave.Period, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SelectedDay.Leave.ExtentText, Mode=OneWay}" />
                            </TextBlock>
                            <Button Command="{Binding AddLeaveCommand}" Margin="0,10,0,0" HorizontalAlignment="Left" Padding="10,6"
                                    Visibility="{Binding CanAddOnSelectedDay, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="Dodaj urlop od tego dnia" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenRequestCommand}" CommandParameter="{Binding SelectedDay.Leave}" Margin="0,10,0,0" HorizontalAlignment="Left" Padding="10,6"
                                    Visibility="{Binding SelectedDay.HasLeave, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="Otwórz wniosek" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <!-- The year's annual leave: days left in large type, with what they are made of. -->
                    <TextBlock Style="{StaticResource FormSection}" Margin="0,4,0,8">
                        <Run Text="Pula urlopu " /><Run Text="{Binding Year, Mode=OneWay}" />
                    </TextBlock>
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="16,12"
                            Visibility="{Binding HasEntitlement, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Text="Zostało do wykorzystania" />
                            <WrapPanel>
                                <TextBlock Text="{Binding RemainingText}" FontSize="28" FontWeight="SemiBold" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding TotalText}" FontSize="16" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                            </WrapPanel>
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- No entitlement yet: say what to do, with the usual values. -->
                    <Border Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" CornerRadius="8" Padding="16,12"
                            Visibility="{Binding HasEntitlement, Converter={StaticResource CollapsedWhenTrue}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Icon}" Margin="0,2,12,0" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                <Button Command="{Binding EditEntitlementCommand}" Content="Ustaw wymiar urlopu" Margin="0,10,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" />

                    <!-- The employee's requests in the year; a double click or Enter opens one with its decision. -->
                    <TextBlock Text="Wnioski w tym roku" Style="{StaticResource FormSection}" Margin="0,20,0,8" />
                    <TextBlock Text="Brak wniosków urlopowych w tym roku." Style="{StaticResource SecondaryText}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    <ListBox x:Name="RequestsList" ItemsSource="{Binding Items}" local:OpenOnActivate.Command="{Binding OpenRequestCommand}" AutomationProperties.Name="Wnioski urlopowe pracownika"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled" ToolTip="Dwuklik otwiera wniosek">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding KindName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type leave:LeaveRow}">
                                <DockPanel Margin="0,4">
                                    <Border DockPanel.Dock="Right" Style="{StaticResource StateBadge}" Margin="8,0,0,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding StateName}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding KindName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap">
                                            <Run Text="{Binding Period, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DaysText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>

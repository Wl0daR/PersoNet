<UserControl x:Class="PersoNet.Desktop.Views.EmployeeLeaveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:leave="clr-namespace:PersoNet.Desktop.Presentation.Leave;assembly=PersoNet.Desktop.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=leave:EmployeeLeaveViewModel}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource BusyArea}" Margin="0,8,0,0">
            <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" AutomationProperties.Name="Trwa wczytywanie urlopu" />
        </Border>

        <!-- Saving the entitlement stays visible while the tab scrolls. -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}" Margin="-12,0">
            <WrapPanel IsEnabled="{Binding IsIdle}">
                <Button Content="Zapisz wymiar urlopu" Command="{Binding SaveEntitlementCommand}" Style="{DynamicResource AccentButtonStyle}" />
            </WrapPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8,0,8,16">
                <!-- Year first: everything below belongs to it. -->
                <DockPanel Margin="0,0,0,12">
                    <ComboBox DockPanel.Dock="Right" x:Name="YearBox" ItemsSource="{Binding Years}" SelectedItem="{Binding Year}" MinWidth="96"
                              AutomationProperties.Name="Rok" ToolTip="Rok urlopowy" />
                    <TextBlock Text="Pula urlopu" Style="{StaticResource FormSection}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Days left in large type, with what they are made of. -->
                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="16,12"
                        Visibility="{Binding HasEntitlement, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Text="Zostało do wykorzystania" />
                        <WrapPanel>
                            <TextBlock Text="{Binding RemainingText}" FontSize="28" FontWeight="SemiBold" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding TotalText}" FontSize="16" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- No entitlement yet: say what to do, with the usual values. -->
                <Border Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" CornerRadius="8" Padding="16,12"
                        Visibility="{Binding HasEntitlement, Converter={StaticResource CollapsedWhenTrue}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Icon}" Margin="0,2,12,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <!-- Entitlement entered by HR. -->
                <WrapPanel IsEnabled="{Binding IsIdle}">
                    <StackPanel Width="160" Margin="0,0,12,0">
                        <Label Content="_Wymiar (dni) *" Target="{Binding ElementName=DaysBox}" Padding="0" Margin="0,16,0,4" />
                        <TextBox x:Name="DaysBox" Text="{Binding EditDays, UpdateSourceTrigger=PropertyChanged}" MaxLength="2"
                                 AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                        <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=DaysBox}" Style="{StaticResource FieldError}" />
                    </StackPanel>
                    <StackPanel Width="160">
                        <Label Content="_Zaległy (dni)" Target="{Binding ElementName=CarriedOverBox}" Padding="0" Margin="0,16,0,4" />
                        <TextBox x:Name="CarriedOverBox" Text="{Binding EditCarriedOver, UpdateSourceTrigger=PropertyChanged}" MaxLength="2"
                                 AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                        <TextBlock Text="Niewykorzystany z poprzedniego roku." Style="{StaticResource HelperText}" />
                        <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=CarriedOverBox}" Style="{StaticResource FieldError}" />
                    </StackPanel>
                </WrapPanel>

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" />

                <!-- The employee's requests in the year; decisions are made on the Urlopy screen. -->
                <TextBlock Text="Wnioski w tym roku" Style="{StaticResource FormSection}" Margin="0,20,0,8" />
                <TextBlock Text="Brak wniosków urlopowych w tym roku." Style="{StaticResource SecondaryText}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Items}" AutomationProperties.Name="Wnioski urlopowe pracownika">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type leave:LeaveRow}">
                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,8">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource StateBadge}" Margin="8,0,0,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding StateName}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding KindName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap">
                                            <Run Text="{Binding Period, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DaysText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

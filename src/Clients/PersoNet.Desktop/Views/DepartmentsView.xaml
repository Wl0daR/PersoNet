<UserControl x:Class="PersoNet.Desktop.Views.DepartmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:org="clr-namespace:PersoNet.Desktop.Presentation.Organization;assembly=PersoNet.Desktop.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=org:DepartmentsViewModel}">
    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="F5" Command="{Binding LoadCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- Department tree. -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Odśwież" Command="{Binding LoadCommand}" ToolTip="Wczytaj działy ponownie (F5)" />
                    <StackPanel>
                        <TextBlock Text="Struktura działów" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="Pokaż nie_aktywne" IsChecked="{Binding ShowInactive}" />
                    </StackPanel>
                </DockPanel>

                <Border DockPanel.Dock="Top" Style="{StaticResource BusyArea}">
                    <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" AutomationProperties.Name="Trwa wczytywanie" />
                </Border>

                <Grid>
                    <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" SelectedItemChanged="OnSelectedItemChanged"
                              AutomationProperties.Name="Struktura działów" BorderThickness="0" Background="Transparent">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type org:DepartmentNode}" ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding DisplayName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <!-- The "nieaktywny" suffix carries the meaning; the grey only reinforces it. -->
                                                <DataTrigger Binding="{Binding Department.IsActive}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="True" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>

                    <!-- Empty state: say what to do next instead of showing a blank area. -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Nie ma jeszcze działów" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
                        <TextBlock Text="Wpisz nazwę i kod pierwszego działu w formularzu obok i kliknij Zapisz."
                                   Style="{StaticResource SecondaryText}" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Editor of the selected or new department. -->
        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel IsEnabled="{Binding IsIdle}">
                <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Pola oznaczone * są wymagane." Style="{StaticResource HelperText}" />

                <Label Content="_Nazwa *" Target="{Binding ElementName=NameBox}" Padding="0" Margin="0,16,0,4" />
                <TextBox x:Name="NameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="{x:Static org:DepartmentsViewModel.NameMaxLength}"
                         AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=NameBox}" Style="{StaticResource FieldError}" />

                <Label Content="_Kod *" Target="{Binding ElementName=CodeBox}" Padding="0" Margin="0,16,0,4" />
                <TextBox x:Name="CodeBox" Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}"
                         CharacterCasing="Upper" MaxLength="{x:Static org:DepartmentsViewModel.CodeMaxLength}"
                         AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                <TextBlock Text="Krótki, unikalny skrót działu, np. IT albo KAD." Style="{StaticResource HelperText}" />
                <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=CodeBox}" Style="{StaticResource FieldError}" />

                <Label Content="_Dział nadrzędny" Target="{Binding ElementName=ParentBox}" Padding="0" Margin="0,16,0,4" />
                <ComboBox x:Name="ParentBox" ItemsSource="{Binding ParentOptions}" SelectedItem="{Binding EditParent}" DisplayMemberPath="Name"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                <TextBlock Text="Zostaw puste, jeśli to dział najwyższego poziomu." Style="{StaticResource HelperText}" />
                <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=ParentBox}" Style="{StaticResource FieldError}" />

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" />

                <!-- One primary action; deactivation sits apart on the right. -->
                <DockPanel Margin="0,24,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Content="Zapisz" Command="{Binding SaveCommand}" IsDefault="True"
                            Style="{DynamicResource AccentButtonStyle}" MinWidth="96" Margin="0,0,8,0" ToolTip="Zapisz zmiany (Enter)" />
                    <Button DockPanel.Dock="Left" Content="Nowy dział" Command="{Binding NewCommand}" ToolTip="Nowy dział pod zaznaczonym (Ctrl+N)" />
                    <Button DockPanel.Dock="Right" Content="{Binding ToggleActiveText}" Command="{Binding ToggleActiveCommand}" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="PersoNet.Desktop.Views.EmployeeWorkTimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:work="clr-namespace:PersoNet.Desktop.Presentation.WorkTime;assembly=PersoNet.Desktop.Presentation"
             xmlns:local="clr-namespace:PersoNet.Desktop.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=work:EmployeeWorkTimeViewModel}">
    <UserControl.Resources>
        <!-- One figure of the month: a small label over the value. -->
        <Style x:Key="Figure" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,28,8" />
            <Setter Property="MinWidth" Value="88" />
        </Style>
        <Style x:Key="FigureValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Saturdays, Sundays and holidays are dimmed, so the working days stand out. -->
        <Style x:Key="DayCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDayOff}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NumberCell" TargetType="TextBlock" BasedOn="{StaticResource DayCell}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
    </UserControl.Resources>

    <!-- Only the list of days scrolls while the window is tall enough; in a short window (laptop at 150%) the whole tab
         scrolls instead, so the list always keeps room for several days. -->
    <ScrollViewer x:Name="Page" Margin="8,12,8,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <DockPanel Height="{Binding ViewportHeight, ElementName=Page}" MinHeight="400">
        <!-- The month and who this is in the time clock system. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ClockIdText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Command="{Binding EditClockIdCommand}" Padding="10,4" ToolTip="Numer karty lub ID użytkownika w systemie RCP, np. Roger PR Master"
                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" Content="Zmień" AutomationProperties.Name="Zmień identyfikator RCP" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsIdle}">
                <Button Command="{Binding PreviousMonthCommand}" Padding="8" Background="Transparent" BorderThickness="0"
                        ToolTip="Poprzedni miesiąc" AutomationProperties.Name="Poprzedni miesiąc">
                    <TextBlock Text="&#xE76B;" Style="{StaticResource Icon}" FontSize="12" />
                </Button>
                <Button Command="{Binding NextMonthCommand}" Padding="8" Background="Transparent" BorderThickness="0"
                        ToolTip="Następny miesiąc" AutomationProperties.Name="Następny miesiąc">
                    <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="12" />
                </Button>
                <TextBlock Text="{Binding MonthTitle}" Style="{StaticResource SectionTitle}" Margin="8,0,12,0" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
                <Button Content="Dziś" Command="{Binding ThisMonthCommand}" Padding="10,4" ToolTip="Wróć do bieżącego miesiąca" />
            </StackPanel>
        </DockPanel>

        <!-- The month in figures. -->
        <WrapPanel DockPanel.Dock="Top" Visibility="{Binding HasSheet, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Style="{StaticResource Figure}" ToolTip="Wymiar czasu pracy w miesiącu (art. 130 Kodeksu pracy), według etatu">
                <TextBlock Text="Wymiar" Style="{StaticResource SecondaryText}" />
                <TextBlock Text="{Binding NormText}" Style="{StaticResource FigureValue}" />
            </StackPanel>
            <StackPanel Style="{StaticResource Figure}">
                <TextBlock Text="Przepracowano" Style="{StaticResource SecondaryText}" />
                <TextBlock Text="{Binding WorkedText}" Style="{StaticResource FigureValue}" />
            </StackPanel>
            <StackPanel Style="{StaticResource Figure}" ToolTip="Godziny ponad 8 w dniu roboczym; przy niepełnym etacie także godziny ponad etat">
                <TextBlock Text="Nadgodziny" Style="{StaticResource SecondaryText}" />
                <TextBlock Text="{Binding OvertimeText}" Style="{StaticResource FigureValue}" />
            </StackPanel>
            <StackPanel Style="{StaticResource Figure}" ToolTip="Praca w porze nocnej, od 22:00 do 6:00">
                <TextBlock Text="W nocy" Style="{StaticResource SecondaryText}" />
                <TextBlock Text="{Binding NightText}" Style="{StaticResource FigureValue}" />
            </StackPanel>
            <StackPanel Style="{StaticResource Figure}" ToolTip="Urlopy i inne nieobecności w godzinach">
                <TextBlock Text="Nieobecności" Style="{StaticResource SecondaryText}" />
                <TextBlock Text="{Binding AbsenceText}" Style="{StaticResource FigureValue}" />
            </StackPanel>
        </WrapPanel>

        <!-- Days the clock could not pair, said in words; the colour only reinforces it. -->
        <Border DockPanel.Dock="Top" CornerRadius="6" Padding="10,6" Margin="0,0,0,8" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                <TextBlock Text="{Binding IssuesText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="{Binding NormHint}" Style="{StaticResource HelperText}" Margin="0,0,0,8"
                   Visibility="{Binding NormHint, Converter={StaticResource CollapsedWhenEmpty}}" />

        <!-- Commands for the month and the picked day. -->
        <WrapPanel DockPanel.Dock="Top" Style="{StaticResource Toolbar}" IsEnabled="{Binding IsIdle}">
            <Button Command="{Binding OpenDayCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="12,6" Margin="0,0,8,8"
                    ToolTip="Wpisz godziny albo nieobecność w zaznaczonym dniu (Enter)"
                    Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Wpisz dzień" />
                </StackPanel>
            </Button>
            <Button Command="{Binding FillFromPlanCommand}" Padding="12,6" Margin="0,0,8,8"
                    ToolTip="Wpisz w puste dni robocze godziny z planu od 8:00, według etatu. Dni z urlopem zostają bez zmian."
                    Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE787;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Wypełnij według planu" />
                </StackPanel>
            </Button>
            <Button Command="{Binding ClearDayCommand}" Padding="12,6" Margin="0,0,8,8"
                    ToolTip="Usuń wpis zaznaczonego dnia; dzień z odbiciami wraca do godzin z czytnika"
                    Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Usuń wpis" />
                </StackPanel>
            </Button>
            <Button Command="{Binding ExportCommand}" Padding="12,6" Margin="0,0,8,8" ToolTip="Zapisz kartę ewidencji miesiąca do pliku Excel">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Eksportuj do Excela" />
                </StackPanel>
            </Button>
            <Button Command="{Binding OpenExportCommand}" Padding="12,6" Margin="0,0,8,8" ToolTip="{Binding ExportPath}"
                    Visibility="{Binding HasExport, Converter={StaticResource BoolToVisibility}}" Content="Otwórz plik" />
        </WrapPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource BusyArea}">
            <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" AutomationProperties.Name="Trwa wczytywanie czasu pracy" />
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding SourceText}" Style="{StaticResource HelperText}" Margin="0,4,0,8" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" />

        <!-- The days of the month. Only this list scrolls; double click or Enter opens a day. -->
        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" local:OpenOnActivate.Command="{Binding OpenDayCommand}"
                  AutomationProperties.Name="Dni miesiąca" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="None" MinRowHeight="32" BorderThickness="0" Background="Transparent"
                  CanUserSortColumns="False" CanUserReorderColumns="False" HorizontalScrollBarVisibility="Disabled">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Dzień" Width="72">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type work:WorkTimeRow}">
                            <TextBlock Text="{Binding DayText}" Style="{StaticResource DayCell}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Godziny" Width="2*" MinWidth="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type work:WorkTimeRow}">
                            <TextBlock Text="{Binding HoursText}" Style="{StaticResource DayCell}" ToolTip="{Binding HoursText}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Plan" Width="64">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type work:WorkTimeRow}">
                            <TextBlock Text="{Binding PlannedText}" Style="{StaticResource NumberCell}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Praca" Width="64">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type work:WorkTimeRow}">
                            <TextBlock Text="{Binding WorkedText}" Style="{StaticResource NumberCell}" FontWeight="SemiBold" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Nadg." Width="64">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type work:WorkTimeRow}">
                            <TextBlock Text="{Binding OvertimeText}" Style="{StaticResource NumberCell}" ToolTip="Nadgodziny i godziny ponad etat" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Noc" Width="56">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type work:WorkTimeRow}">
                            <TextBlock Text="{Binding NightText}" Style="{StaticResource NumberCell}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Uwagi" Width="2*" MinWidth="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type work:WorkTimeRow}">
                            <Border HorizontalAlignment="Left" ToolTip="{Binding StatusText}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasIssue}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                                <Setter Property="CornerRadius" Value="10" />
                                                <Setter Property="Padding" Value="8,1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource DayCell}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
    </ScrollViewer>
</UserControl>

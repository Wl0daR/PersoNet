<UserControl x:Class="PersoNet.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:reports="clr-namespace:PersoNet.Desktop.Presentation.Reports;assembly=PersoNet.Desktop.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=reports:ReportsViewModel}">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding Selected.LoadCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding Selected.ExportCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- Text of a table cell: one line, centred in the row, cut with "…" when the column is narrow. -->
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- A cell of two lines: the main text over a smaller grey one, e.g. a name over the number and position. -->
        <Style x:Key="TwoLines" TargetType="StackPanel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,8,6" />
        </Style>

        <Style x:Key="SecondLine" TargetType="TextBlock" BasedOn="{StaticResource HelperText}">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ReportGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="MinRowHeight" Value="44" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserSortColumns" Value="True" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <!-- Export of the shown report, and opening the saved file. Shared by every report. -->
        <DataTemplate x:Key="ExportButtons" DataType="{x:Type reports:ReportViewModel}">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding ExportCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="12,6" Margin="0,0,8,8"
                        ToolTip="Zapisz ten raport jako skoroszyt programu Excel (Ctrl+E)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Eksportuj do Excela" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenExportCommand}" Padding="12,6" Margin="0,0,8,8" ToolTip="{Binding ExportPath}"
                        Visibility="{Binding HasExport, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Otwórz zapisany plik" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DataTemplate>

        <!-- Refresh, kept at the right edge as on the other screens. -->
        <DataTemplate x:Key="RefreshButton" DataType="{x:Type reports:ReportViewModel}">
            <Button Command="{Binding LoadCommand}" Padding="8" Margin="8,0,0,0" VerticalAlignment="Top" ToolTip="Odśwież (F5)" AutomationProperties.Name="Odśwież">
                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" />
            </Button>
        </DataTemplate>

        <!-- The line under the toolbar: totals of the report and a problem, if any. -->
        <DataTemplate x:Key="SummaryLine" DataType="{x:Type reports:ReportViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryText}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="BusyBar" DataType="{x:Type reports:ReportViewModel}">
            <Border Style="{StaticResource BusyArea}" Margin="16,8,16,0">
                <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" AutomationProperties.Name="Trwa wczytywanie raportu" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Page header: what this screen is. -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Raporty" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Zestawienia dla całej firmy. Każdy raport zapiszesz do Excela tak, jak go widzisz."
                       Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </StackPanel>

        <TabControl SelectedIndex="{Binding SelectedIndex}" Padding="0,12,0,0" BorderThickness="0" Background="Transparent">
            <!-- Headcount on a day. -->
            <TabItem Header="_Stan zatrudnienia" DataContext="{Binding Headcount}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource RefreshButton}" />
                        <WrapPanel Style="{StaticResource Toolbar}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                                <Label Content="_Na dzień" Target="{Binding ElementName=HeadcountDate}" Padding="0" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <DatePicker x:Name="HeadcountDate" SelectedDate="{Binding Date}" MinWidth="150" />
                            </StackPanel>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ExportButtons}" />
                        </WrapPanel>
                    </DockPanel>
                    <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource SummaryLine}" Margin="0,0,0,8" />

                    <!-- Totals of each department, as short chips that wrap on a narrow window. -->
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Departments}" Focusable="False" Margin="0,0,0,8"
                                  AutomationProperties.Name="Podsumowanie działów">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type reports:HeadcountDepartmentRow}">
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,4" Margin="0,0,8,6">
                                    <TextBlock>
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding People, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding FullTime, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource BusyBar}" />
                            <Grid>
                                <DataGrid ItemsSource="{Binding Rows}" Style="{StaticResource ReportGrid}" AutomationProperties.Name="Stan zatrudnienia">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Pracownik" SortMemberPath="Name" Width="1.6*" MinWidth="190">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type reports:HeadcountRow}">
                                                    <StackPanel Style="{StaticResource TwoLines}">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Details}" Style="{StaticResource SecondLine}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Dział" Binding="{Binding Department}" ElementStyle="{StaticResource Cell}" Width="1.1*" MinWidth="120" />
                                        <DataGridTemplateColumn Header="Umowa" SortMemberPath="Contract" Width="1.5*" MinWidth="170">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type reports:HeadcountRow}">
                                                    <StackPanel Style="{StaticResource TwoLines}" ToolTip="{Binding Contract}">
                                                        <TextBlock Text="{Binding Contract}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ContractDetails}" Style="{StaticResource SecondLine}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Zatrudniony od" Binding="{Binding HireDate, StringFormat=dd.MM.yyyy}" ElementStyle="{StaticResource Cell}" Width="Auto" MinWidth="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="Nikt nie był zatrudniony w tym dniu" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,4" />
                                    <TextBlock Text="Wybierz inny dzień." Style="{StaticResource SecondaryText}" TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- Annual leave in a year. -->
            <TabItem Header="_Wykorzystanie urlopów" DataContext="{Binding LeaveUsage}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource RefreshButton}" />
                        <WrapPanel Style="{StaticResource Toolbar}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                                <Button Command="{Binding PreviousYearCommand}" Padding="8" ToolTip="Poprzedni rok" AutomationProperties.Name="Poprzedni rok">
                                    <TextBlock Text="&#xE76B;" Style="{StaticResource Icon}" FontSize="14" />
                                </Button>
                                <TextBlock FontSize="16" FontWeight="SemiBold" MinWidth="90" TextAlignment="Center" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite">
                                    <Run Text="Rok " /><Run Text="{Binding Year, Mode=OneWay}" />
                                </TextBlock>
                                <Button Command="{Binding NextYearCommand}" Padding="8" ToolTip="Następny rok" AutomationProperties.Name="Następny rok">
                                    <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="14" />
                                </Button>
                            </StackPanel>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ExportButtons}" />
                        </WrapPanel>
                    </DockPanel>
                    <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource SummaryLine}" Margin="0,0,0,8" />

                    <Border Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource BusyBar}" />
                            <Grid>
                                <DataGrid ItemsSource="{Binding Rows}" Style="{StaticResource ReportGrid}" AutomationProperties.Name="Wykorzystanie urlopów">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Pracownik" SortMemberPath="Name" Width="1.6*" MinWidth="190">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type reports:LeaveUsageLine}">
                                                    <StackPanel Style="{StaticResource TwoLines}">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Details}" Style="{StaticResource SecondLine}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Wymiar" Binding="{Binding Entitlement}" SortMemberPath="Row.TotalHours" ElementStyle="{StaticResource Cell}" Width="1.2*" MinWidth="130" />
                                        <DataGridTextColumn Header="Wykorzystany" Binding="{Binding Used}" SortMemberPath="Row.UsedHours" ElementStyle="{StaticResource Cell}" Width="Auto" MinWidth="110" />
                                        <DataGridTextColumn Header="Czeka na decyzję" Binding="{Binding Pending}" SortMemberPath="Row.PendingHours" ElementStyle="{StaticResource Cell}" Width="Auto" MinWidth="120" />
                                        <DataGridTemplateColumn Header="Pozostało" SortMemberPath="RemainingHours" Width="Auto" MinWidth="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type reports:LeaveUsageLine}">
                                                    <TextBlock Text="{Binding Remaining}" Style="{StaticResource Cell}" FontWeight="SemiBold" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Na żądanie" Binding="{Binding OnDemand}" SortMemberPath="Row.OnDemandDays" ElementStyle="{StaticResource Cell}" Width="Auto" MinWidth="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="&#xE787;" Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="Nikt nie był zatrudniony w tym roku" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,4" />
                                    <TextBlock Text="Wybierz inny rok." Style="{StaticResource SecondaryText}" TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- Contracts that end soon. -->
            <TabItem Header="_Kończące się umowy" DataContext="{Binding ContractsEnding}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource RefreshButton}" />
                        <WrapPanel Style="{StaticResource Toolbar}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                                <Label Content="_Kończą się w ciągu" Target="{Binding ElementName=PeriodBox}" Padding="0" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <ComboBox x:Name="PeriodBox" ItemsSource="{x:Static reports:ContractsEndingReportViewModel.Periods}" SelectedItem="{Binding Period}"
                                          DisplayMemberPath="Name" MinWidth="120" />
                            </StackPanel>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ExportButtons}" />
                        </WrapPanel>
                    </DockPanel>
                    <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource SummaryLine}" Margin="0,0,0,8" />

                    <Border Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource BusyBar}" />
                            <Grid>
                                <DataGrid ItemsSource="{Binding Rows}" Style="{StaticResource ReportGrid}" AutomationProperties.Name="Kończące się umowy">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Pracownik" SortMemberPath="Name" Width="1.8*" MinWidth="200">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type reports:ContractEndingLine}">
                                                    <StackPanel Style="{StaticResource TwoLines}">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Details}" Style="{StaticResource SecondLine}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Umowa" Binding="{Binding Contract}" ElementStyle="{StaticResource Cell}" Width="1.6*" MinWidth="160" />
                                        <DataGridTextColumn Header="Koniec" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}" ElementStyle="{StaticResource Cell}" Width="Auto" MinWidth="96" />
                                        <DataGridTextColumn Header="Zostało" Binding="{Binding DaysLeftText}" SortMemberPath="DaysLeft" ElementStyle="{StaticResource Cell}" Width="Auto" MinWidth="90" />
                                        <DataGridTemplateColumn Header="Kolejna umowa" SortMemberPath="HasNextContract" Width="Auto" MinWidth="160">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type reports:ContractEndingLine}">
                                                    <Border x:Name="Badge" Style="{StaticResource Badge}" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding NextContract}" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding HasNextContract}" Value="True">
                                                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                                            <Setter TargetName="Badge" Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasNextContract}" Value="False">
                                                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="&#xE930;" Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="Żadna umowa nie kończy się w tym okresie" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,4" />
                                    <TextBlock Text="Wybierz dłuższy okres, aby zajrzeć dalej." Style="{StaticResource SecondaryText}" TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </TabItem>
            <!-- Medical certificates and mandatory trainings to renew. -->
            <TabItem Header="_Badania i szkolenia" DataContext="{Binding SafetyRenewals}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource RefreshButton}" />
                        <WrapPanel Style="{StaticResource Toolbar}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                                <Label Content="_Tracą ważność w ciągu" Target="{Binding ElementName=SafetyPeriodBox}" Padding="0" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <ComboBox x:Name="SafetyPeriodBox" ItemsSource="{x:Static reports:ContractsEndingReportViewModel.Periods}" SelectedItem="{Binding Period}"
                                          DisplayMemberPath="Name" MinWidth="120" />
                            </StackPanel>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ExportButtons}" />
                        </WrapPanel>
                    </DockPanel>
                    <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource SummaryLine}" Margin="0,0,0,8" />

                    <Border Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource BusyBar}" />
                            <Grid>
                                <DataGrid ItemsSource="{Binding Rows}" Style="{StaticResource ReportGrid}" AutomationProperties.Name="Badania i szkolenia do odnowienia">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Pracownik" SortMemberPath="Name" Width="1.6*" MinWidth="200">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type reports:SafetyRenewalLine}">
                                                    <StackPanel Style="{StaticResource TwoLines}">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Details}" Style="{StaticResource SecondLine}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Co" Binding="{Binding Item}" ElementStyle="{StaticResource Cell}" Width="1.8*" MinWidth="180" />
                                        <DataGridTemplateColumn Header="Stan" SortMemberPath="Row.State" Width="Auto" MinWidth="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type reports:SafetyRenewalLine}">
                                                    <Border Style="{StaticResource ToneBadge}" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding State}" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Kiedy" Binding="{Binding When}" SortMemberPath="Row.ValidUntil" ElementStyle="{StaticResource Cell}" Width="Auto" MinWidth="140" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="&#xE930;" Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="Wszystkie badania i szkolenia są ważne" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,4" />
                                    <TextBlock Text="Wybierz dłuższy okres, aby zajrzeć dalej." Style="{StaticResource SecondaryText}" TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>

<UserControl x:Class="PersoNet.Desktop.Views.RolesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:acc="clr-namespace:PersoNet.Desktop.Presentation.Access;assembly=PersoNet.Desktop.Presentation"
             xmlns:local="clr-namespace:PersoNet.Desktop.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=acc:RolesViewModel}">
    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="F5" Command="{Binding LoadCommand}" />
    </UserControl.InputBindings>

    <DockPanel>
        <!-- Page header: what this screen is. -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Role i uprawnienia" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Rola mówi, co może osoba, która ją ma. Role nadajesz w kartotece pracownika, w zakładce Konto."
                       Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Commands: a new role, change or remove the picked one (removal needs a second click). -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Command="{Binding LoadCommand}" Padding="8" Margin="8,0,0,0" VerticalAlignment="Top"
                    ToolTip="Odśwież (F5)" AutomationProperties.Name="Odśwież">
                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" />
            </Button>
            <WrapPanel Style="{StaticResource Toolbar}" IsEnabled="{Binding IsIdle}">
                <Button Command="{Binding NewCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="12,6" Margin="0,0,8,8" ToolTip="Nowa rola (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Nowa rola" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding EditCommand}" Padding="12,6" Margin="0,0,8,8" ToolTip="Zmień zaznaczoną rolę (Enter)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Zmień" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeleteCommand}" Padding="12,6" Margin="0,0,8,8" ToolTip="Usuń rolę, której nikt nie ma">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding DeleteText}" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </DockPanel>

        <!-- The HR administrator is not a role in the list: they always have everything, so HR cannot lock itself out. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="16,10" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Icon}" FontSize="16" Margin="0,2,12,0" VerticalAlignment="Top"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryText}"
                           Text="Administrator kadr ma zawsze wszystkie uprawnienia, także zakładanie kont w portalu. Role służą pozostałym osobom, np. kierownikom." />
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" Margin="0,8,0,0" />

        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource BusyArea}" Margin="16,8,16,0">
                    <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" AutomationProperties.Name="Trwa wczytywanie" />
                </Border>

                <Grid>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Role"
                              local:OpenOnActivate.Command="{Binding EditCommand}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" MinRowHeight="48"
                              GridLinesVisibility="None" BorderThickness="0" Background="Transparent" Padding="8,0"
                              HorizontalScrollBarVisibility="Disabled" CanUserReorderColumns="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Rola" Width="2*" MinWidth="160" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type acc:RoleRow}">
                                        <StackPanel VerticalAlignment="Center" Margin="0,4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Description}" Visibility="{Binding Description, Converter={StaticResource CollapsedWhenEmpty}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Uprawnienia" Width="3*" MinWidth="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type acc:RoleRow}">
                                        <TextBlock Text="{Binding PermissionsText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,4" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Kto ma" Width="Auto" MinWidth="90" SortMemberPath="Role.MemberCount">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type acc:RoleRow}">
                                        <TextBlock Text="{Binding MembersText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state: say what to do next instead of showing a blank area. -->
                    <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xE8D7;" Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Nie ma jeszcze ról" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="Kliknij „Nowa rola”, np. „Kierownik działu” z prawem do decyzji urlopowych." Style="{StaticResource SecondaryText}"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>

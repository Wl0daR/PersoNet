<UserControl x:Class="PersoNet.Desktop.Views.DepartmentDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:org="clr-namespace:PersoNet.Desktop.Presentation.Organization;assembly=PersoNet.Desktop.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=org:DepartmentDialogViewModel}"
             Width="480">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" IsEnabled="{Binding IsIdle}">
                <Button Content="Zapisz" Command="{Binding SaveCommand}" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" MinWidth="110" Margin="0,0,8,0" />
                <Button Content="Anuluj" IsCancel="True" MinWidth="110" ToolTip="Zamknij bez zapisywania (Esc)" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource DialogBody}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,20" IsEnabled="{Binding IsIdle}">
                    <TextBlock Text="Pola oznaczone * są wymagane." Style="{StaticResource HelperText}" Margin="0" />

                    <Label Content="_Nazwa *" Target="{Binding ElementName=NameBox}" Padding="0" Margin="0,16,0,4" />
                    <TextBox x:Name="NameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="{x:Static org:DepartmentDialogViewModel.NameMaxLength}"
                             AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                    <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=NameBox}" Style="{StaticResource FieldError}" />

                    <Label Content="_Kod *" Target="{Binding ElementName=CodeBox}" Padding="0" Margin="0,16,0,4" />
                    <TextBox x:Name="CodeBox" Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}" MinWidth="160" HorizontalAlignment="Left"
                             CharacterCasing="Upper" MaxLength="{x:Static org:DepartmentDialogViewModel.CodeMaxLength}"
                             AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                    <TextBlock Text="Krótki, unikalny skrót działu, np. IT albo KAD." Style="{StaticResource HelperText}" />
                    <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=CodeBox}" Style="{StaticResource FieldError}" />

                    <Label Content="_Dział nadrzędny" Target="{Binding ElementName=ParentBox}" Padding="0" Margin="0,16,0,4" />
                    <ComboBox x:Name="ParentBox" ItemsSource="{Binding ParentOptions}" SelectedItem="{Binding EditParent}" DisplayMemberPath="Name"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                    <TextBlock Text="Zostaw „brak”, jeśli to dział najwyższego poziomu." Style="{StaticResource HelperText}" />
                    <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=ParentBox}" Style="{StaticResource FieldError}" />

                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>

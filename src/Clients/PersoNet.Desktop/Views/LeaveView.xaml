<UserControl x:Class="PersoNet.Desktop.Views.LeaveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:leave="clr-namespace:PersoNet.Desktop.Presentation.Leave;assembly=PersoNet.Desktop.Presentation"
             xmlns:local="clr-namespace:PersoNet.Desktop.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=leave:LeaveViewModel}">
    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="F5" Command="{Binding LoadCommand}" />
    </UserControl.InputBindings>

    <DockPanel>
        <!-- Page header: what this screen is. -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Urlopy" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Wnioski urlopowe pracowników. Wniosek otwiera się w osobnym oknie, gdzie go zatwierdzisz albo odrzucisz."
                       Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </StackPanel>

        <!-- Commands for the list: a new request, open the picked one, and the filters. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Command="{Binding LoadCommand}" Padding="8" Margin="8,0,0,0" VerticalAlignment="Top"
                    ToolTip="Odśwież (F5)" AutomationProperties.Name="Odśwież">
                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" />
            </Button>
            <WrapPanel Style="{StaticResource Toolbar}">
                <Button Command="{Binding NewCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="12,6" Margin="0,0,8,8" ToolTip="Wniosek w imieniu pracownika (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Nowy wniosek" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenCommand}" Padding="12,6" Margin="0,0,16,8" ToolTip="Szczegóły i decyzja w sprawie zaznaczonego wniosku (Enter)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Otwórz wniosek" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                    <Label Content="_Pokaż" Target="{Binding ElementName=StateBox}" Padding="0" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <ComboBox x:Name="StateBox" ItemsSource="{x:Static leave:LeaveViewModel.States}" SelectedItem="{Binding StateFilter}"
                              DisplayMemberPath="Name" MinWidth="170" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Label Content="_Rok" Target="{Binding ElementName=YearBox}" Padding="0" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <ComboBox x:Name="YearBox" ItemsSource="{Binding Years}" SelectedItem="{Binding Year}" MinWidth="96" />
                </StackPanel>
            </WrapPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" Margin="0,8,0,0" />

        <!-- Requests across the whole window. -->
        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource BusyArea}" Margin="16,8,16,0">
                    <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" AutomationProperties.Name="Trwa wczytywanie" />
                </Border>

                <Grid>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" local:OpenOnActivate.Command="{Binding OpenCommand}"
                              AutomationProperties.Name="Wnioski urlopowe" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              HeadersVisibility="Column" MinRowHeight="52" GridLinesVisibility="None" BorderThickness="0" Background="Transparent" Padding="8,0"
                              HorizontalScrollBarVisibility="Disabled" CanUserSortColumns="False" CanUserReorderColumns="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Pracownik" Width="1.6*" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type leave:LeaveRow}">
                                        <DockPanel VerticalAlignment="Center" Margin="0,6">
                                            <Border DockPanel.Dock="Left" Style="{StaticResource Avatar}" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding EmployeeInitials}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Request.EmployeeName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Request.EmployeeNumber}" Style="{StaticResource HelperText}" Margin="0,2,0,0" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Rodzaj" Width="1.4*" MinWidth="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type leave:LeaveRow}">
                                        <TextBlock Text="{Binding KindName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding KindName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Termin" Width="1.2*" MinWidth="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type leave:LeaveRow}">
                                        <TextBlock Text="{Binding Period}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Period}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Wymiar" Width="Auto" MinWidth="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type leave:LeaveRow}">
                                        <TextBlock Text="{Binding DaysText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Status" Width="Auto" MinWidth="112">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type leave:LeaveRow}">
                                        <Border Style="{StaticResource StateBadge}" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding StateName}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xE787;" Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,4" />
                        <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource SecondaryText}" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>

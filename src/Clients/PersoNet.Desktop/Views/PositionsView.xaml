<UserControl x:Class="PersoNet.Desktop.Views.PositionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:org="clr-namespace:PersoNet.Desktop.Presentation.Organization;assembly=PersoNet.Desktop.Presentation"
             xmlns:local="clr-namespace:PersoNet.Desktop.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=org:PositionsViewModel}">
    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="F5" Command="{Binding LoadCommand}" />
    </UserControl.InputBindings>

    <DockPanel>
        <!-- Page header: what this screen is. -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Stanowiska" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Wspólny słownik stanowisk; dział i stanowisko przypisujesz w kartotece pracownika." Style="{StaticResource SecondaryText}"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </StackPanel>

        <!-- Commands: a new position, rename or (de)activate the picked one. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Command="{Binding LoadCommand}" Padding="8" Margin="8,0,0,0" VerticalAlignment="Top"
                    ToolTip="Odśwież (F5)" AutomationProperties.Name="Odśwież">
                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" />
            </Button>
            <WrapPanel Style="{StaticResource Toolbar}" IsEnabled="{Binding IsIdle}">
                <Button Command="{Binding NewCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="12,6" Margin="0,0,8,8" ToolTip="Nowe stanowisko (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Nowe stanowisko" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding EditCommand}" Padding="12,6" Margin="0,0,8,8" ToolTip="Zmień nazwę zaznaczonego stanowiska (Enter)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Zmień" />
                    </StackPanel>
                </Button>
                <Button Content="{Binding ToggleActiveText}" Command="{Binding ToggleActiveCommand}" Padding="12,6" Margin="0,0,16,8" />
                <CheckBox Content="Pokaż nie_aktywne" IsChecked="{Binding ShowInactive}" VerticalAlignment="Center" Margin="0,0,0,8" />
            </WrapPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" Margin="0,8,0,0" />

        <!-- Position list across the whole window. -->
        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource BusyArea}" Margin="16,8,16,0">
                    <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" AutomationProperties.Name="Trwa wczytywanie" />
                </Border>

                <Grid>
                    <DataGrid ItemsSource="{Binding Positions}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Stanowiska"
                              local:OpenOnActivate.Command="{Binding EditCommand}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" MinRowHeight="40"
                              GridLinesVisibility="None" BorderThickness="0" Background="Transparent" Padding="8,0"
                              HorizontalScrollBarVisibility="Disabled" CanUserReorderColumns="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Nazwa" Width="*" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE821;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Text rather than a checkbox: readable at a glance and does not look editable. -->
                            <DataGridTemplateColumn Header="Status" Width="Auto" SortMemberPath="IsActive">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,8,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource SuccessBadge}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" />
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="aktywne" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text" Value="nieaktywne" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state: say what to do next instead of showing a blank area. -->
                    <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xE821;" Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Nie ma jeszcze stanowisk" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="Kliknij „Nowe stanowisko”, aby dodać pierwsze stanowisko." Style="{StaticResource SecondaryText}" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>

<UserControl x:Class="PersoNet.Desktop.Views.PositionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:org="clr-namespace:PersoNet.Desktop.Presentation.Organization;assembly=PersoNet.Desktop.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=org:PositionsViewModel}">
    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="F5" Command="{Binding LoadCommand}" />
    </UserControl.InputBindings>

    <DockPanel>
        <!-- Page header: what this screen is, and its main action on the right. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button Command="{Binding LoadCommand}" Padding="8" Margin="0,0,8,0" ToolTip="Odśwież (F5)" AutomationProperties.Name="Odśwież">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" />
                </Button>
                <Button Command="{Binding NewCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="12,8" ToolTip="Nowe stanowisko (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                        <TextBlock Text="Nowe stanowisko" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Stanowiska" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Wspólny słownik stanowisk; dział i stanowisko przypisujesz w kartotece pracownika." Style="{StaticResource SecondaryText}"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" MinWidth="320" MaxWidth="520" />
            </Grid.ColumnDefinitions>

            <!-- Position list. -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,16,16,8">
                        <CheckBox DockPanel.Dock="Right" Content="Pokaż nie_aktywne" IsChecked="{Binding ShowInactive}" Margin="12,0,0,0" />
                        <TextBlock Text="Słownik" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
                    </DockPanel>

                    <Border DockPanel.Dock="Top" Style="{StaticResource BusyArea}" Margin="16,0,16,4">
                        <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" AutomationProperties.Name="Trwa wczytywanie" />
                    </Border>

                    <Grid>
                        <DataGrid ItemsSource="{Binding Positions}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Stanowiska"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" MinRowHeight="40"
                                  GridLinesVisibility="None" BorderThickness="0" Background="Transparent" Padding="8,0"
                                  HorizontalScrollBarVisibility="Disabled" CanUserReorderColumns="False">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Nazwa" Width="*" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE821;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Text rather than a checkbox: readable at a glance and does not look editable. -->
                                <DataGridTemplateColumn Header="Status" Width="Auto" SortMemberPath="IsActive">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,8,0">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource SuccessBadge}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" />
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="aktywne" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Text" Value="nieaktywne" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty state: say what to do next instead of showing a blank area. -->
                        <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="&#xE821;" Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="Nie ma jeszcze stanowisk" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                            <TextBlock Text="Wpisz nazwę pierwszego stanowiska w formularzu obok i kliknij Zapisz."
                                       Style="{StaticResource SecondaryText}" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent" Focusable="False"
                          ResizeBehavior="PreviousAndNext" ToolTip="Przeciągnij, aby zmienić szerokość" />

            <!-- Editor of the selected or new position. -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <!-- Save on the left, deactivation apart on the right; both stay visible while the form scrolls. -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
                        <DockPanel IsEnabled="{Binding IsIdle}">
                            <Button DockPanel.Dock="Right" Content="{Binding ToggleActiveText}" Command="{Binding ToggleActiveCommand}" Margin="8,0,0,0" />
                            <WrapPanel>
                                <Button Content="Zapisz" Command="{Binding SaveCommand}" IsDefault="True"
                                        Style="{DynamicResource AccentButtonStyle}" MinWidth="96" ToolTip="Zapisz zmiany (Enter)" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,20,20,16" IsEnabled="{Binding IsIdle}">
                            <TextBlock Text="{Binding EditorTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="Pola oznaczone * są wymagane." Style="{StaticResource HelperText}" />

                            <Label Content="_Nazwa stanowiska *" Target="{Binding ElementName=NameBox}" Padding="0" Margin="0,16,0,4" />
                            <TextBox x:Name="NameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="{x:Static org:PositionsViewModel.NameMaxLength}"
                                     AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                            <TextBlock Text="Np. Specjalista ds. kadr, Kierownik zespołu." Style="{StaticResource HelperText}" />
                            <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=NameBox}" Style="{StaticResource FieldError}" />

                            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

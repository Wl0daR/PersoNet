<UserControl x:Class="PersoNet.Desktop.Views.PositionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:org="clr-namespace:PersoNet.Desktop.Presentation.Organization;assembly=PersoNet.Desktop.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=org:PositionsViewModel}">
    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="F5" Command="{Binding LoadCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- Position list. -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Odśwież" Command="{Binding LoadCommand}" ToolTip="Wczytaj stanowiska ponownie (F5)" />
                    <StackPanel>
                        <TextBlock Text="Stanowiska" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="Pokaż nie_aktywne" IsChecked="{Binding ShowInactive}" />
                    </StackPanel>
                </DockPanel>

                <Border DockPanel.Dock="Top" Style="{StaticResource BusyArea}">
                    <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" AutomationProperties.Name="Trwa wczytywanie" />
                </Border>

                <Grid>
                    <DataGrid ItemsSource="{Binding Positions}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Stanowiska"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="*" />
                            <!-- Text rather than a checkbox: readable at a glance and does not look editable. -->
                            <DataGridTemplateColumn Header="Status" Width="120" SortMemberPath="IsActive">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Aktywne" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Text" Value="Nieaktywne" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state: say what to do next instead of showing a blank area. -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Nie ma jeszcze stanowisk" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
                        <TextBlock Text="Wpisz nazwę pierwszego stanowiska w formularzu obok i kliknij Zapisz."
                                   Style="{StaticResource SecondaryText}" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Editor of the selected or new position. -->
        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel IsEnabled="{Binding IsIdle}">
                <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Pola oznaczone * są wymagane." Style="{StaticResource HelperText}" />

                <Label Content="_Nazwa stanowiska *" Target="{Binding ElementName=NameBox}" Padding="0" Margin="0,16,0,4" />
                <TextBox x:Name="NameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="{x:Static org:PositionsViewModel.NameMaxLength}"
                         AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                <TextBlock Text="Np. Specjalista ds. kadr, Kierownik zespołu." Style="{StaticResource HelperText}" />
                <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=NameBox}" Style="{StaticResource FieldError}" />

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" />

                <!-- One primary action; deactivation sits apart on the right. -->
                <DockPanel Margin="0,24,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Content="Zapisz" Command="{Binding SaveCommand}" IsDefault="True"
                            Style="{DynamicResource AccentButtonStyle}" MinWidth="96" Margin="0,0,8,0" ToolTip="Zapisz zmiany (Enter)" />
                    <Button DockPanel.Dock="Left" Content="Nowe stanowisko" Command="{Binding NewCommand}" ToolTip="Nowe stanowisko (Ctrl+N)" />
                    <Button DockPanel.Dock="Right" Content="{Binding ToggleActiveText}" Command="{Binding ToggleActiveCommand}" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

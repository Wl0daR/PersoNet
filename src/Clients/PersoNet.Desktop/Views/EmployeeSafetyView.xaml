<UserControl x:Class="PersoNet.Desktop.Views.EmployeeSafetyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:safety="clr-namespace:PersoNet.Desktop.Presentation.Safety;assembly=PersoNet.Desktop.Presentation"
             xmlns:local="clr-namespace:PersoNet.Desktop.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=safety:EmployeeSafetyViewModel}">
    <DockPanel Margin="8,12,8,8">
        <!-- Commands: add an examination or a training, change or remove the picked one (removal needs a second click). -->
        <WrapPanel DockPanel.Dock="Top" Style="{StaticResource Toolbar}" IsEnabled="{Binding IsIdle}"
                   Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
            <Button Command="{Binding NewExamCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="12,6" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Dodaj badanie" />
                </StackPanel>
            </Button>
            <Button Command="{Binding NewTrainingCommand}" Padding="12,6" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Dodaj szkolenie" />
                </StackPanel>
            </Button>
            <Button Command="{Binding EditCommand}" Padding="12,6" Margin="0,0,8,8" ToolTip="Zmień zaznaczone badanie lub szkolenie (Enter)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Zmień" />
                </StackPanel>
            </Button>
            <Button Command="{Binding DeleteCommand}" Padding="12,6" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding DeleteText}" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource BusyArea}">
            <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" AutomationProperties.Name="Trwa wczytywanie badań i szkoleń" />
        </Border>

        <!-- The state of the medical certificate first: without a valid one the employee may not work. -->
        <Border DockPanel.Dock="Top" CornerRadius="4" Padding="12,8" Margin="0,0,0,8" BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Visibility="{Binding ExamSummary, Converter={StaticResource CollapsedWhenEmpty}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ExamTone}" Value="Ok">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ExamTone}" Value="Warning">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ExamTone}" Value="Critical">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="&#xE95E;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding ExamSummary}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </DockPanel>
                <DockPanel Margin="0,4,0,0" Visibility="{Binding HasMissing, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding MissingText}" TextWrapping="Wrap" />
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" />

        <Grid>
            <!-- Examinations, then trainings, the latest first. Double click or Enter changes one. -->
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" local:OpenOnActivate.Command="{Binding EditCommand}"
                      AutomationProperties.Name="Badania i szkolenia pracownika" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="None" MinRowHeight="44" BorderThickness="0" Background="Transparent"
                      CanUserSortColumns="False" CanUserReorderColumns="False" HorizontalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Badanie / szkolenie" Width="2.4*" MinWidth="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type safety:SafetyRow}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                    <TextBlock Text="{Binding Kind}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Data" Width="*" MinWidth="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type safety:SafetyRow}">
                                <TextBlock Text="{Binding DateText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Ważne do" Width="*" MinWidth="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type safety:SafetyRow}">
                                <TextBlock Text="{Binding ValidUntilText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Stan" Width="1.4*" MinWidth="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type safety:SafetyRow}">
                                <Border Style="{StaticResource ToneBadge}" Margin="0,0,8,0" ToolTip="{Binding StateText}">
                                    <TextBlock Text="{Binding StateText}" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Uwagi" Width="1.6*" MinWidth="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type safety:SafetyRow}">
                                <TextBlock Text="{Binding Note}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="&#xE7BE;" Style="{StaticResource Icon}" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Brak badań i szkoleń" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="Orzeczenia lekarskie i ukończone szkolenia BHP wpiszesz przyciskami „Dodaj badanie” i „Dodaj szkolenie”." Style="{StaticResource SecondaryText}"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>

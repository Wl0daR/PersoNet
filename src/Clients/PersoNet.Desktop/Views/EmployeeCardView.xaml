<UserControl x:Class="PersoNet.Desktop.Views.EmployeeCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:emp="clr-namespace:PersoNet.Desktop.Presentation.Employees;assembly=PersoNet.Desktop.Presentation"
             xmlns:local="clr-namespace:PersoNet.Desktop.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=emp:EmployeeCardViewModel}"
             Width="820" Height="680">
    <UserControl.Resources>
        <!-- Contracts, leave and the account belong to a saved card, so their tabs wait until then. -->
        <Style x:Key="SavedCardTab" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNew}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="ToolTip" Value="Najpierw zapisz kartotekę pracownika." />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Save and close, always in the same place at the bottom right. -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding IsIdle}">
                    <Button Content="Zapisz" Command="{Binding SaveCommand}" IsDefault="True" Style="{DynamicResource AccentButtonStyle}"
                            MinWidth="110" Margin="0,0,8,0" ToolTip="Zapisz dane z zakładki Dane (Enter)"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Zamknij" IsCancel="True" MinWidth="110" ToolTip="Zamknij okno (Esc)" />
                </StackPanel>
                <!-- Confirmation of a save, so the user knows it worked. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                            Visibility="{Binding SavedMessage, Converter={StaticResource CollapsedWhenEmpty}}">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    <TextBlock Text="{Binding SavedMessage}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource DialogBody}">
            <DockPanel>
                <!-- Who this is, at a glance. -->
                <DockPanel DockPanel.Dock="Top" Margin="24,20,24,8">
                    <Border DockPanel.Dock="Left" Style="{StaticResource Avatar}" Width="48" Height="48" CornerRadius="24" VerticalAlignment="Top">
                        <TextBlock Text="{Binding CardInitials}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <WrapPanel>
                            <TextBlock Text="{Binding EditorTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,10,0" />
                            <Border VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEmployed}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusBadge}" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding CardSubtitle}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>

                <Border DockPanel.Dock="Top" Style="{StaticResource BusyArea}" Margin="24,0,24,0">
                    <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" AutomationProperties.Name="Trwa zapisywanie" />
                </Border>

                <TabControl x:Name="Tabs" Margin="16,0,16,0" Padding="0" BorderThickness="0" Background="Transparent">
                    <TabItem Header="_Dane">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <!-- Read-only for someone who may see the cards but not change them. -->
                            <Border IsEnabled="{Binding CanEdit}">
                            <StackPanel Margin="8,4,8,20" IsEnabled="{Binding IsIdle}">
                                <TextBlock Text="Pola oznaczone * są wymagane." Style="{StaticResource HelperText}" Margin="0,8,0,0" />

                                <!-- Two columns side by side: who the person is, and their employment. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Dane podstawowe" Style="{StaticResource FormSection}" Margin="0,12,0,0" />
                                        <Label Content="Nu_mer ewidencyjny *" Target="{Binding ElementName=NumberBox}" Padding="0" Margin="0,12,0,4" />
                                        <TextBox x:Name="NumberBox" Text="{Binding EditNumber, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"
                                                 MaxLength="{x:Static emp:EmployeeCardViewModel.NumberMaxLength}"
                                                 AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                                        <TextBlock Text="Unikalny w firmie, np. P0042." Style="{StaticResource HelperText}" />
                                        <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=NumberBox}" Style="{StaticResource FieldError}" />

                                        <Label Content="_Imię *" Target="{Binding ElementName=FirstNameBox}" Padding="0" Margin="0,16,0,4" />
                                        <TextBox x:Name="FirstNameBox" Text="{Binding EditFirstName, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="{x:Static emp:EmployeeCardViewModel.NameMaxLength}"
                                                 AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                                        <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=FirstNameBox}" Style="{StaticResource FieldError}" />

                                        <Label Content="Na_zwisko *" Target="{Binding ElementName=LastNameBox}" Padding="0" Margin="0,16,0,4" />
                                        <TextBox x:Name="LastNameBox" Text="{Binding EditLastName, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="{x:Static emp:EmployeeCardViewModel.NameMaxLength}"
                                                 AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                                        <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=LastNameBox}" Style="{StaticResource FieldError}" />

                                        <TextBlock Text="Kontakt" Style="{StaticResource FormSection}" />
                                        <Label Content="_E-mail służbowy" Target="{Binding ElementName=EmailBox}" Padding="0" Margin="0,12,0,4" />
                                        <TextBox x:Name="EmailBox" Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="{x:Static emp:EmployeeCardViewModel.EmailMaxLength}"
                                                 AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                                        <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=EmailBox}" Style="{StaticResource FieldError}" />

                                        <Label Content="_Telefon" Target="{Binding ElementName=PhoneBox}" Padding="0" Margin="0,16,0,4" />
                                        <TextBox x:Name="PhoneBox" Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="{x:Static emp:EmployeeCardViewModel.PhoneMaxLength}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Zatrudnienie" Style="{StaticResource FormSection}" Margin="0,12,0,0" />
                                        <Label Content="Data _zatrudnienia *" Target="{Binding ElementName=HireDateBox}" Padding="0" Margin="0,12,0,4" />
                                        <DatePicker x:Name="HireDateBox" SelectedDate="{Binding EditHireDate}" HorizontalAlignment="Left" MinWidth="200"
                                                    AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                                        <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=HireDateBox}" Style="{StaticResource FieldError}" />

                                        <Label Content="_Dział" Target="{Binding ElementName=DepartmentBox}" Padding="0" Margin="0,16,0,4" />
                                        <ComboBox x:Name="DepartmentBox" ItemsSource="{Binding Departments}" SelectedItem="{Binding EditDepartment}"
                                                  DisplayMemberPath="Name" HorizontalAlignment="Stretch" IsTextSearchEnabled="True"
                                                  AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                                        <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=DepartmentBox}" Style="{StaticResource FieldError}" />

                                        <Label Content="_Stanowisko" Target="{Binding ElementName=PositionBox}" Padding="0" Margin="0,16,0,4" />
                                        <ComboBox x:Name="PositionBox" ItemsSource="{Binding Positions}" SelectedItem="{Binding EditPosition}"
                                                  DisplayMemberPath="Name" HorizontalAlignment="Stretch" IsTextSearchEnabled="True"
                                                  AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                                        <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=PositionBox}" Style="{StaticResource FieldError}" />

                                        <Label Content="_Przełożony" Target="{Binding ElementName=ManagerBox}" Padding="0" Margin="0,16,0,4" />
                                        <ComboBox x:Name="ManagerBox" ItemsSource="{Binding Managers}" SelectedItem="{Binding EditManager}"
                                                  DisplayMemberPath="Name" HorizontalAlignment="Stretch" IsTextSearchEnabled="True"
                                                  AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                                        <TextBlock Text="Wpisz pierwsze litery nazwiska, aby szybko znaleźć osobę." Style="{StaticResource HelperText}" />
                                        <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=ManagerBox}" Style="{StaticResource FieldError}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FormError}" />

                                <!-- End of employment: separate from everyday edits, with the date asked for explicitly. -->
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="16,4,16,16" Margin="0,24,0,0"
                                        Visibility="{Binding IsNew, Converter={StaticResource CollapsedWhenTrue}}">
                                    <StackPanel>
                                        <TextBlock Text="Koniec zatrudnienia" Style="{StaticResource FormSection}" Margin="0,12,0,0" />
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />

                                        <WrapPanel Visibility="{Binding IsEmployed, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Margin="0,0,12,0">
                                                <Label Content="_Ostatni dzień pracy" Target="{Binding ElementName=LastDayBox}" Padding="0" Margin="0,12,0,4" />
                                                <DatePicker x:Name="LastDayBox" SelectedDate="{Binding TerminationLastDay}" MinWidth="200"
                                                            AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                                                <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=LastDayBox}" Style="{StaticResource FieldError}" />
                                            </StackPanel>
                                            <Button Content="Zakończ zatrudnienie" Command="{Binding TerminateCommand}" VerticalAlignment="Bottom" Margin="0,12,0,0" />
                                        </WrapPanel>
                                        <TextBlock Text="Osoba zniknie z listy po tym dniu, a jej umowy zakończą się tego dnia; dane zostają w kartotece." Style="{StaticResource HelperText}"
                                                   Visibility="{Binding IsEmployed, Converter={StaticResource BoolToVisibility}}" />

                                        <!-- A former employee who comes back: a new hire date; the old contracts stay ended. -->
                                        <WrapPanel Visibility="{Binding IsTerminated, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Margin="0,0,12,0">
                                                <Label Content="_Data ponownego zatrudnienia" Target="{Binding ElementName=RehireBox}" Padding="0" Margin="0,12,0,4" />
                                                <DatePicker x:Name="RehireBox" SelectedDate="{Binding RehireDate}" MinWidth="200"
                                                            AutomationProperties.HelpText="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
                                                <TextBlock Text="{Binding (Validation.Errors)/ErrorContent, ElementName=RehireBox}" Style="{StaticResource FieldError}" />
                                            </StackPanel>
                                            <Button Content="Zatrudnij ponownie" Command="{Binding RehireCommand}" Style="{DynamicResource AccentButtonStyle}"
                                                    VerticalAlignment="Bottom" Margin="0,12,12,0" />
                                            <Button Content="Cofnij zakończenie zatrudnienia" Command="{Binding ReinstateCommand}" VerticalAlignment="Bottom" Margin="0,12,0,0"
                                                    ToolTip="Gdy zakończenie wpisano przez pomyłkę: umowy wracają do pierwotnych dat." />
                                        </WrapPanel>
                                        <TextBlock Text="„Zatrudnij ponownie”, gdy osoba wraca do pracy; dotychczasowe umowy pozostają zakończone. „Cofnij” tylko, gdy zakończenie wpisano przez pomyłkę."
                                                   Style="{StaticResource HelperText}" TextWrapping="Wrap"
                                                   Visibility="{Binding IsTerminated, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="_Umowy" Style="{StaticResource SavedCardTab}">
                        <local:ContractsView DataContext="{Binding Contracts}" />
                    </TabItem>
                    <TabItem Header="Ur_lop" Style="{StaticResource SavedCardTab}"
                             Visibility="{Binding CanSeeLeave, Converter={StaticResource BoolToVisibility}}">
                        <local:EmployeeLeaveView DataContext="{Binding Leave}" />
                    </TabItem>
                    <TabItem Header="_Konto" Style="{StaticResource SavedCardTab}"
                             Visibility="{Binding CanSeeAccessTab, Converter={StaticResource BoolToVisibility}}">
                        <!-- The portal account and the roles: what the person may sign in to, and what they may do there. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,0,20">
                                <local:EmployeeAccountView DataContext="{Binding Account}"
                                                           Visibility="{Binding DataContext.CanManageAccount, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=1}, Converter={StaticResource BoolToVisibility}}" />
                                <local:EmployeeRolesView DataContext="{Binding Roles}"
                                                         Visibility="{Binding DataContext.CanManageRoles, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=1}, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="_Historia" Style="{StaticResource SavedCardTab}" IsSelected="{Binding History.IsActive}"
                             Visibility="{Binding CanSeeHistory, Converter={StaticResource BoolToVisibility}}">
                        <local:EmployeeHistoryView DataContext="{Binding History}" />
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>

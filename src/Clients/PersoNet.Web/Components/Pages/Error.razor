@page "/Error"
@attribute [AllowAnonymous]
@using System.Diagnostics

<PageTitle>Błąd – PersoNet</PageTitle>

<h1>Coś poszło nie tak</h1>
<p class="text-muted-foreground">Spróbuj ponownie za chwilę. Jeśli błąd się powtarza, przekaż administratorowi poniższy identyfikator.</p>

@if (ShowRequestId)
{
    <p>
        Identyfikator żądania: <code>@RequestId</code>
    </p>
}

<a class="btn btn-primary" href="">Wróć na stronę główną</a>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}

@page "/"

<PageTitle>Strona główna – PersoNet</PageTitle>

<AuthorizeView>
    <h1>Dzień dobry, @(context.User.FindFirst("given_name")?.Value ?? context.User.FindFirst("name")?.Value)</h1>
    <p class="text-muted-foreground">Zalogowano jako @context.User.FindFirst("email")?.Value</p>
</AuthorizeView>

<section class="surface mt-4" aria-labelledby="soon-title">
    <h2 id="soon-title">Portal pracownika jest w przygotowaniu</h2>
    <p class="mb-0 text-muted-foreground">
        Wkrótce znajdziesz tu swoje dane kadrowe i wnioski urlopowe, a kierownicy także akceptację wniosków zespołu.
    </p>
</section>

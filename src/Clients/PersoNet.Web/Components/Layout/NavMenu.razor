<div class="brand-row">
    <a class="brand" href="">PersoNet</a>
    <label class="menu-toggle" for="nav-toggle">
        <span class="visually-hidden">Pokaż lub ukryj menu</span>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
            <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" />
        </svg>
    </label>
</div>

<input type="checkbox" id="nav-toggle" class="nav-toggle" />

<nav class="nav-scrollable" aria-label="Menu główne" onclick="document.getElementById('nav-toggle').checked = false">
    <ul class="nav-list">
        <li>
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                    <path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" fill="none" />
                </svg>
                Strona główna
            </NavLink>
        </li>
        @if (_profile?.Profile is not null)
        {
            <li>
                <NavLink class="nav-link" href="moj-urlop">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                        <path d="M4 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zM4 10h16M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                    </svg>
                    Mój urlop
                </NavLink>
            </li>
        }
        @if (_profile?.IsManager == true)
        {
            <li>
                <NavLink class="nav-link" href="zespol">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                        <path d="M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM3 21v-1a6 6 0 0 1 12 0v1M16 3.13a4 4 0 0 1 0 7.75M21 21v-1a6 6 0 0 0-4-5.65" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                    </svg>
                    Wnioski zespołu
                </NavLink>
            </li>
        }
    </ul>
</nav>

@code {
    private MyProfileResult? _profile;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    [Inject]
    private MyProfile Me { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // The portal links need the employee record, which only signed-in people have.
        if (AuthenticationState is not null && (await AuthenticationState).User.Identity?.IsAuthenticated == true)
        {
            _profile = await Me.GetAsync(CancellationToken.None);
        }
    }
}

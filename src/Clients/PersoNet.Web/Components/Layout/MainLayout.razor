@inherits LayoutComponentBase

<a class="skip-link" href="#content">Przejdź do treści</a>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <header class="top-row">
            <AuthorizeView>
                <Authorized>
                    <span class="user" title="@context.User.FindFirst("email")?.Value">@context.User.FindFirst("name")?.Value</span>
                    <form action="account/logout" method="post">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-quiet">Wyloguj</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-primary" href="account/login">Zaloguj</a>
                </NotAuthorized>
            </AuthorizeView>
        </header>

        <article id="content" class="content" tabindex="-1">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" role="alert" data-nosnippet>
    Wystąpił nieoczekiwany błąd.
    <a href="." class="reload">Odśwież stronę</a>
    <button type="button" class="dismiss" aria-label="Zamknij komunikat">×</button>
</div>

@* The state of a leave request: an icon and its name, never colour alone. *@

<span class="badge-state @CssClass">
    <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
        <path d="@Icon" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    </svg>
    @LeaveTexts.StateName(State)
</span>

@code {
    [Parameter, EditorRequired]
    public LeaveState State { get; set; }

    private string CssClass => State switch
    {
        LeaveState.Pending => "is-pending",
        LeaveState.Approved => "is-approved",
        LeaveState.Rejected => "is-rejected",
        _ => "is-cancelled",
    };

    private string Icon => State switch
    {
        LeaveState.Pending => "M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z",
        LeaveState.Approved => "M5 12.5l4.5 4.5L19 7.5",
        LeaveState.Rejected => "M7 7l10 10M17 7 7 17",
        _ => "M5 12h14",
    };
}
